<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_background }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {%- assign brand_name = 'Antared' -%}
      {%- assign branded_page_title = page_title | replace: 'ParetoPhysio', brand_name | replace: 'Pareto Physio', brand_name -%}
      {%- if request.page_type == 'index' -%}
        {%- if request.locale.iso_code contains 'fr' -%}
          Antared | Luminoth&eacute;rapie rouge intelligente
        {%- else -%}
          Antared | Intelligent Red Light Therapy
        {%- endif -%}
      {%- else -%}
        {{ branded_page_title }}{% if current_tags %}{%- assign meta_tags = current_tags | join: ', ' -%} &ndash; {{ 'general.meta.tags' | t: tags: meta_tags }}{% endif %}{% if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif %}{% unless branded_page_title contains brand_name %} &ndash; {{ brand_name }}{% endunless %}
      {%- endif -%}
    </title>

    {%- if request.page_type == 'index' -%}
      <meta name="description" content="{% if request.locale.iso_code contains 'fr' %}D&eacute;couvrez Antared, des syst&egrave;mes intelligents de luminoth&eacute;rapie rouge et proche infrarouge pour la r&eacute;cup&eacute;ration, la peau, le sommeil et l'&eacute;nergie.{% else %}Discover Antared intelligent red and near-infrared light therapy systems for recovery, skin, sleep, and everyday energy.{% endif %}">
    {%- elsif page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {%- comment -%}
      Rendu avant content_for_header : Shopify n'y injecte qu'un og:image
      generique, celui du snippet doit apparaitre en premier pour primer.
    {%- endcomment -%}
    {% render 'meta-social' %}

    {%- comment -%}
      Polices auto-hebergees sur le CDN Shopify.

      Elles etaient chargees depuis fonts.googleapis.com : une feuille de style
      tierce bloquant le rendu, plus deux preconnexions, et surtout la
      transmission de l'IP de chaque visiteur a Google sans consentement
      prealable, ce que la CNIL et la jurisprudence europeenne sanctionnent.
      Sous-ensemble latin uniquement (64 Ko) : il couvre le francais, l'anglais
      et le portugais.
    {%- endcomment -%}
    <link rel="preload" as="font" type="font/woff2" href="{{ 'instrument-sans-latin.woff2' | asset_url }}" crossorigin>
    <link rel="preload" as="font" type="font/woff2" href="{{ 'instrument-serif-latin.woff2' | asset_url }}" crossorigin>

    {{ content_for_header }}

    {% render 'structured-data' %}
    {% render 'marketing-pixels' %}

    {{ 'theme.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'theme.js' | asset_url }}" defer></script>

    <style>
      @font-face {
        font-family: 'Instrument Sans';
        font-style: normal;
        font-weight: 400 700;
        font-display: swap;
        src: url({{ 'instrument-sans-latin.woff2' | asset_url }}) format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: 'Instrument Serif';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url({{ 'instrument-serif-latin.woff2' | asset_url }}) format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: 'Instrument Serif';
        font-style: italic;
        font-weight: 400;
        font-display: swap;
        src: url({{ 'instrument-serif-italic-latin.woff2' | asset_url }}) format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }

      :root {
        --color-background: {{ settings.color_background }};
        --color-background-soft: {{ settings.color_background_soft }};
        --color-foreground: {{ settings.color_foreground }};
        --color-muted: {{ settings.color_muted }};
        --color-accent: {{ settings.color_accent }};
        --color-accent-soft: {{ settings.color_accent_soft }};
        --color-accent-deep: {{ settings.color_accent_deep }};
        --color-promo: {{ settings.color_promo }};
        --color-rating: #FFC247;
        --font-body: '{{ settings.font_body }}', system-ui, -apple-system, sans-serif;
        --font-display: '{{ settings.font_display }}', Georgia, serif;
        --radius-sm: 6px;
        --radius-md: 12px;
        --radius-lg: 20px;
        --container: 1280px;
      }
    </style>
  </head>

  <body class="template-{{ template.name }}">
    <a class="skip-to-content" href="#MainContent">{{ 'accessibility.skip_to_text' | t }}</a>

    {% section 'header' %}

    <main id="MainContent" role="main">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    <div id="cart-drawer-mount"></div>
  </body>
</html>
