# Copie ce fichier en ".env" (ou ".env.local") et remplis les valeurs.
# Ne jamais committer le fichier ".env" rempli — il est ignoré par .gitignore.

# Domaine de la boutique Shopify
SHOPIFY_FLAG_STORE=cytolight.myshopify.com

# Admin API access token (scopes: read_themes, write_themes)
# Genere via: Dev Dashboard > Cytolight > API credentials > Reveal token once
SHOPIFY_CLI_THEME_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID du theme live (visible dans l'URL de l'editeur de theme)
# https://admin.shopify.com/store/paretophysio/themes/<THEME_ID>/editor
SHOPIFY_THEME_ID=198072500565
