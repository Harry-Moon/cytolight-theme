{%- liquid
  assign is_fr = false
  assign is_pt = false
  if request.locale.iso_code contains 'fr'
    assign is_fr = true
  endif
  if request.locale.iso_code contains 'pt'
    assign is_pt = true
  endif
-%}

<header class="site-header">
  <div class="site-header__proof" aria-label="Store benefits">
    <span>{% if is_fr %}Livraison rapide{% elsif is_pt %}Envio rapido{% else %}Fast shipping{% endif %}</span>
    <span>{% if is_fr %}Essai 30 jours{% elsif is_pt %}Teste de 30 dias{% else %}30-day trial{% endif %}</span>
    <span>{% if is_fr %}Garantie 2 ans{% elsif is_pt %}Garantia de 2 anos{% else %}2-year warranty{% endif %}</span>
  </div>
  <div class="container site-header__inner">
    <nav class="site-header__nav" aria-label="{% if is_fr %}Navigation principale{% elsif is_pt %}Navegacao principal{% else %}Primary navigation{% endif %}">
      <a href="{{ routes.root_url }}">{% if is_fr %}Accueil{% elsif is_pt %}Inicio{% else %}Home{% endif %}</a>
      <div class="site-header__nav-item" data-nav-submenu>
        <a class="site-header__nav-link" href="{{ routes.all_products_collection_url }}">{% if is_fr %}Produits{% elsif is_pt %}Produtos{% else %}Products{% endif %}</a>
        <button type="button" class="site-header__submenu-toggle" aria-expanded="false" aria-label="{% if is_fr %}Afficher le sous-menu Produits{% elsif is_pt %}Mostrar submenu Produtos{% else %}Show Products submenu{% endif %}">
          <svg viewBox="0 0 10 6" width="10" height="6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="site-header__submenu">
          <a href="/products/cytolight-desk">DESK</a>
          <a href="/products/cytolight-cap">{% if is_fr %}Cheveux{% elsif is_pt %}Cabelo{% else %}Hair{% endif %}</a>
          <a href="/products/cytolight-foot">{% if is_fr %}Pieds{% elsif is_pt %}Pes{% else %}Foot{% endif %}</a>
          <a href="/products/cytolight-knee">{% if is_fr %}Genou{% elsif is_pt %}Joelho{% else %}Knee{% endif %}</a>
          <a href="/products/cytolight-mask">{% if is_fr %}Visage{% elsif is_pt %}Rosto{% else %}Face{% endif %}</a>
          <a href="/products/cytolight-pano-ultra">{% if is_fr %}Corps entier{% elsif is_pt %}Corpo inteiro{% else %}Full body{% endif %}</a>
        </div>
      </div>
      {%- comment -%}
        Espace editorial. Les URL et les libelles des quatre sous-pages vivent
        dans snippets/learn-nav.liquid, partages avec le menu mobile et avec la
        barre de sous-navigation des pages Learn : un handle qui change ne se
        corrige qu'a un seul endroit.
      {%- endcomment -%}
      {% render 'learn-nav', variant: 'header' %}
    </nav>

    <a class="site-header__logo" href="{{ routes.root_url }}">
      {%- if section.settings.logo != blank -%}
        {%- comment -%}
          height="auto" n'est pas une valeur valide pour l'attribut : le
          navigateur l'ignore, ne connait plus le ratio et decale la mise en
          page a l'arrivee de l'image. La hauteur est calculee depuis le ratio
          reel du fichier.
        {%- endcomment -%}
        <img src="{{ section.settings.logo | image_url: width: 240 }}"
             width="120" height="{{ 120 | divided_by: section.settings.logo.aspect_ratio | round }}"
             alt="CytoLight">
      {%- else -%}
        <img src="{{ 'cytolight-logo.jpg' | file_url }}"
             width="170" height="62"
             alt="CytoLight">
      {%- endif -%}
    </a>

    <div class="site-header__utils">
      <a class="site-header__compare" href="{{ routes.all_products_collection_url }}">{% if is_fr %}Comparer{% elsif is_pt %}Comparar{% else %}Compare{% endif %}</a>
      {%- if localization.available_languages.size > 1 -%}
        {% form 'localization', class: 'site-header__language-form' %}
          <label class="visually-hidden" for="HeaderLanguageSelector">Language</label>
          <select id="HeaderLanguageSelector" class="site-header__language-select" name="locale_code" onchange="this.form.submit()">
            {%- for language in localization.available_languages -%}
              <option value="{{ language.iso_code }}" {% if language.iso_code == localization.language.iso_code %}selected{% endif %}>
                {{ language.iso_code | upcase }}
              </option>
            {%- endfor -%}
          </select>
        {% endform %}
      {%- else -%}
        <span class="site-header__language-static" aria-label="Current language">
          {{ localization.language.iso_code | default: request.locale.iso_code | upcase }}
        </span>
      {%- endif -%}
      <a href="{{ routes.search_url }}" aria-label="{% if is_fr %}Rechercher{% elsif is_pt %}Pesquisar{% else %}Search{% endif %}">
        {% render 'icon', name: 'search' %}
      </a>
      <a href="{{ routes.account_url }}" aria-label="{% if is_fr %}Mon compte{% elsif is_pt %}Minha conta{% else %}Account{% endif %}">
        {% render 'icon', name: 'user' %}
      </a>
      {%- comment -%}
        Le nom accessible doit contenir le texte visible, ici le compteur
        d'articles, sinon la commande vocale "cliquer sur Panier" ne trouve pas
        la cible (WCAG 2.5.3, echec label-content-name-mismatch releve par
        Lighthouse). Les libelles etaient par ailleurs en anglais sur les trois
        langues du fichier.
      {%- endcomment -%}
      <a href="{{ routes.cart_url }}" aria-label="{% if is_fr %}Panier, {{ cart.item_count }} article{% if cart.item_count > 1 %}s{% endif %}{% elsif is_pt %}Carrinho, {{ cart.item_count }} artigo{% if cart.item_count > 1 %}s{% endif %}{% else %}Cart, {{ cart.item_count }} item{% if cart.item_count > 1 %}s{% endif %}{% endif %}">
        {% render 'icon', name: 'cart' %}
        <span class="site-header__cart-count">{{ cart.item_count }}</span>
      </a>
      <a class="site-header__cta" href="{{ routes.all_products_collection_url }}">{% if is_fr %}Acheter{% elsif is_pt %}Comprar{% else %}Buy now{% endif %}</a>
    </div>

    <details class="site-header__mobile-menu">
      <summary>{% if is_fr %}Menu{% elsif is_pt %}Menu{% else %}Menu{% endif %}</summary>
      <div class="site-header__mobile-panel">
        <a href="{{ routes.root_url }}">{% if is_fr %}Accueil{% elsif is_pt %}Inicio{% else %}Home{% endif %}</a>
        <a href="{{ routes.all_products_collection_url }}">{% if is_fr %}Voir tous les produits{% elsif is_pt %}Ver todos os produtos{% else %}View all products{% endif %}</a>
        <a href="/products/cytolight-desk">CytoLight DESK</a>
        <a href="/products/cytolight-cap">CytoLight REDLIGHT CAP</a>
        <a href="/products/cytolight-foot">CytoLight FOOT</a>
        <a href="/products/cytolight-knee">CytoLight KNEE</a>
        <a href="/products/cytolight-mask">CytoLight MASK</a>
        <a href="/products/cytolight-pano-plus">CytoLight PANO PLUS</a>
        <a href="/products/cytolight-pano-ultra">CytoLight PANO ULTRA</a>
        {% render 'learn-nav', variant: 'mobile' %}
      </div>
    </details>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo (leave blank to use shop name)"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
