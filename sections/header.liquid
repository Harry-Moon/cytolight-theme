{%- liquid
  assign is_fr = false
  assign is_pt = false
  if request.locale.iso_code contains 'fr'
    assign is_fr = true
  endif
  if request.locale.iso_code contains 'pt'
    assign is_pt = true
  endif
-%}

<header class="site-header">
  <div class="site-header__proof" aria-label="Store benefits">
    <span>{% if is_fr %}Livraison rapide{% elsif is_pt %}Envio rapido{% else %}Fast shipping{% endif %}</span>
    <span>{% if is_fr %}Essai 30 jours{% elsif is_pt %}Teste de 30 dias{% else %}30-day trial{% endif %}</span>
    <span>{% if is_fr %}Garantie 2 ans{% elsif is_pt %}Garantia de 2 anos{% else %}2-year warranty{% endif %}</span>
  </div>
  <div class="container site-header__inner">
    <nav class="site-header__nav" aria-label="{% if is_fr %}Navigation principale{% elsif is_pt %}Navegacao principal{% else %}Primary navigation{% endif %}">
      <a href="{{ routes.root_url }}">{% if is_fr %}Accueil{% elsif is_pt %}Inicio{% else %}Home{% endif %}</a>

      <div class="site-header__nav-item" data-nav-submenu>
        <button type="button" class="site-header__nav-link" aria-expanded="false">
          {% if is_fr %}Boutique{% elsif is_pt %}Loja{% else %}Shop{% endif %}
          <svg class="site-header__submenu-toggle" viewBox="0 0 10 6" width="10" height="6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="site-header__megamenu site-header__megamenu--wide">
          <a href="{{ routes.all_products_collection_url }}">{% if is_fr %}Tous les produits{% elsif is_pt %}Todos os produtos{% else %}All Products{% endif %}</a>
          <a href="/products/cytolight-mask">{% if is_fr %}Masque{% elsif is_pt %}Mascara{% else %}Mask{% endif %}</a>
          <a href="/products/cytolight-knee">{% if is_fr %}Genou{% elsif is_pt %}Joelho{% else %}Knee{% endif %}</a>
          <a href="/products/cytolight-desk">{% if is_fr %}Desk{% elsif is_pt %}Desk{% else %}Desk{% endif %}</a>
          <a href="{{ collections['panels'].url }}">{% if is_fr %}Panneaux{% elsif is_pt %}Paineis{% else %}Panels{% endif %}</a>
          <a href="/products/cytolight-sauna-dome">{% if is_fr %}Dôme{% elsif is_pt %}Domo{% else %}Dome{% endif %}</a>
          <a href="/pages/bundles">{% if is_fr %}Packs{% elsif is_pt %}Kits{% else %}Bundles{% endif %}</a>
          <a href="/products/cytolight-cap">{% if is_fr %}Casquette{% elsif is_pt %}Bone{% else %}Cap{% endif %}</a>
          <a href="/products/cytolight-foot">{% if is_fr %}Pieds{% elsif is_pt %}Pes{% else %}Foot{% endif %}</a>
        </div>
      </div>

      <div class="site-header__nav-item" data-nav-submenu>
        <button type="button" class="site-header__nav-link" aria-expanded="false">
          {% if is_fr %}Par objectif{% elsif is_pt %}Por objetivo{% else %}By Goal{% endif %}
          <svg class="site-header__submenu-toggle" viewBox="0 0 10 6" width="10" height="6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="site-header__megamenu">
          <a href="{{ collections['recovery'].url }}">{% if is_fr %}Récupération{% elsif is_pt %}Recuperacao{% else %}Recovery{% endif %}</a>
          <a href="{{ collections['performance'].url }}">{% if is_fr %}Performance{% elsif is_pt %}Performance{% else %}Performance{% endif %}</a>
          <a href="{{ collections['skin-amp-glow'].url }}">{% if is_fr %}Peau &amp; Éclat{% elsif is_pt %}Pele &amp; Brilho{% else %}Skin &amp; Glow{% endif %}</a>
          <a href="{{ collections['longevity'].url }}">{% if is_fr %}Longévité{% elsif is_pt %}Longevidade{% else %}Longevity{% endif %}</a>
          <a href="{{ collections['work-amp-focus'].url }}">{% if is_fr %}Travail &amp; Concentration{% elsif is_pt %}Trabalho &amp; Foco{% else %}Work &amp; Focus{% endif %}</a>
        </div>
      </div>

      <div class="site-header__nav-item" data-nav-submenu>
        <button type="button" class="site-header__nav-link" aria-expanded="false">
          {% if is_fr %}Protocoles{% elsif is_pt %}Protocolos{% else %}Protocols{% endif %}
          <svg class="site-header__submenu-toggle" viewBox="0 0 10 6" width="10" height="6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="site-header__megamenu">
          <a href="/pages/protocols">{% if is_fr %}Tous les protocoles{% elsif is_pt %}Todos os protocolos{% else %}All Protocols{% endif %}</a>
          <a href="/pages/pre-workout">{% if is_fr %}Avant l'entraînement{% elsif is_pt %}Pre-treino{% else %}Pre-Workout{% endif %}</a>
          <a href="/pages/post-workout">{% if is_fr %}Après l'entraînement{% elsif is_pt %}Pos-treino{% else %}Post-Workout{% endif %}</a>
          <a href="/pages/daily-recovery">{% if is_fr %}Récupération quotidienne{% elsif is_pt %}Recuperacao diaria{% else %}Daily Recovery{% endif %}</a>
          <a href="/pages/skin-routine">{% if is_fr %}Routine peau{% elsif is_pt %}Rotina de pele{% else %}Skin Routine{% endif %}</a>
          <a href="/pages/full-body-routine">{% if is_fr %}Routine corps entier{% elsif is_pt %}Rotina corpo inteiro{% else %}Full Body Routine{% endif %}</a>
          <a href="/pages/workday-routine">{% if is_fr %}Routine travail{% elsif is_pt %}Rotina de trabalho{% else %}Workday Routine{% endif %}</a>
        </div>
      </div>

      <div class="site-header__nav-item" data-nav-submenu>
        <button type="button" class="site-header__nav-link" aria-expanded="false">
          {% if is_fr %}Apprendre{% elsif is_pt %}Aprender{% else %}Learn{% endif %}
          <svg class="site-header__submenu-toggle" viewBox="0 0 10 6" width="10" height="6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="site-header__megamenu site-header__megamenu--wide">
          <a href="/pages/academy">{% if is_fr %}Acad&eacute;mie CytoLight{% elsif is_pt %}Academia CytoLight{% else %}CytoLight Academy{% endif %}</a>
          <a href="/pages/comment-ca-marche">{% if is_fr %}Comment &ccedil;a marche{% elsif is_pt %}Como funciona{% else %}How It Works{% endif %}</a>
          <a href="/pages/wavelengths">{% if is_fr %}Longueurs d'onde{% elsif is_pt %}Comprimentos de onda{% else %}Wavelengths{% endif %}</a>
          <a href="/pages/science">{% if is_fr %}Science{% elsif is_pt %}Ci&ecirc;ncia{% else %}Science{% endif %}</a>
          <a href="/pages/how-to-use">{% if is_fr %}Mode d'emploi{% elsif is_pt %}Como usar{% else %}How to Use{% endif %}</a>
          <a href="/pages/faq">FAQ</a>
          <a href="/pages/nos-valeurs">{% if is_fr %}Nos valeurs{% elsif is_pt %}Os nossos valores{% else %}Our values{% endif %}</a>
          <a href="/blogs/news">Blog</a>
        </div>
      </div>

      <div class="site-header__nav-item site-header__nav-item--right" data-nav-submenu>
        <button type="button" class="site-header__nav-link" aria-expanded="false">
          CytoLight Pro
          <svg class="site-header__submenu-toggle" viewBox="0 0 10 6" width="10" height="6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="site-header__megamenu">
          <a href="/pages/clinics">{% if is_fr %}Cliniques{% elsif is_pt %}Clinicas{% else %}Clinics{% endif %}</a>
          <a href="/pages/physios">{% if is_fr %}Kinésithérapeutes{% elsif is_pt %}Fisioterapeutas{% else %}Physios{% endif %}</a>
          <a href="/pages/gyms">{% if is_fr %}Salles de sport{% elsif is_pt %}Academias{% else %}Gyms{% endif %}</a>
          <a href="/pages/hotels-spas">{% if is_fr %}Hôtels &amp; Spas{% elsif is_pt %}Hoteis &amp; Spas{% else %}Hotels &amp; Spas{% endif %}</a>
          <a href="/pages/corporate-wellness">{% if is_fr %}Bien-être en entreprise{% elsif is_pt %}Bem-estar corporativo{% else %}Corporate Wellness{% endif %}</a>
          <a href="/pages/become-a-dealer">{% if is_fr %}Devenir revendeur{% elsif is_pt %}Torne-se revendedor{% else %}Become a Dealer{% endif %}</a>
        </div>
      </div>

      <div class="site-header__nav-item site-header__nav-item--right" data-nav-submenu>
        <button type="button" class="site-header__nav-link" aria-expanded="false">
          {% if is_fr %}Pourquoi CytoLight{% elsif is_pt %}Por que CytoLight{% else %}Why CytoLight{% endif %}
          <svg class="site-header__submenu-toggle" viewBox="0 0 10 6" width="10" height="6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="site-header__megamenu">
          <a href="/pages/technology">{% if is_fr %}Technologie{% elsif is_pt %}Tecnologia{% else %}Technology{% endif %}</a>
          <a href="/pages/quality">{% if is_fr %}Qualité{% elsif is_pt %}Qualidade{% else %}Quality{% endif %}</a>
          <a href="/pages/our-approach">{% if is_fr %}Notre approche{% elsif is_pt %}Nossa abordagem{% else %}Our Approach{% endif %}</a>
          <a href="/pages/our-story">{% if is_fr %}Notre histoire{% elsif is_pt %}Nossa historia{% else %}Our Story{% endif %}</a>
        </div>
      </div>
    </nav>

    <a class="site-header__logo" href="{{ routes.root_url }}">
      {%- if section.settings.logo != blank -%}
        <img src="{{ section.settings.logo | image_url: width: 240 }}"
             width="120" height="auto"
             alt="CytoLight">
      {%- else -%}
        <img src="{{ 'cytolight-logo.jpg' | file_url }}"
             width="170" height="62"
             alt="CytoLight">
      {%- endif -%}
    </a>

    <div class="site-header__utils">
      {%- if localization.available_languages.size > 1 -%}
        {% form 'localization', class: 'site-header__language-form' %}
          <label class="visually-hidden" for="HeaderLanguageSelector">Language</label>
          <select id="HeaderLanguageSelector" class="site-header__language-select" name="locale_code" onchange="this.form.submit()">
            {%- for language in localization.available_languages -%}
              <option value="{{ language.iso_code }}" {% if language.iso_code == localization.language.iso_code %}selected{% endif %}>
                {{ language.iso_code | upcase }}
              </option>
            {%- endfor -%}
          </select>
        {% endform %}
      {%- else -%}
        <span class="site-header__language-static" aria-label="Current language">
          {{ localization.language.iso_code | default: request.locale.iso_code | upcase }}
        </span>
      {%- endif -%}
      <a href="{{ routes.search_url }}" aria-label="Search">
        {% render 'icon', name: 'search' %}
        <span class="visually-hidden">Search</span>
      </a>
      <a href="{{ routes.account_url }}" aria-label="Account">
        {% render 'icon', name: 'user' %}
      </a>
      <a href="{{ routes.cart_url }}" aria-label="Cart">
        {% render 'icon', name: 'cart' %}
        <span class="site-header__cart-count">{{ cart.item_count }}</span>
      </a>
      <a class="site-header__cta" href="/pages/find-your-cytolight">{% if is_fr %}Trouvez votre CytoLight{% elsif is_pt %}Encontre seu CytoLight{% else %}Find Your CytoLight{% endif %}</a>
    </div>

