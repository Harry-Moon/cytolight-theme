{%- comment -%}
  Header principal.

  Structure inspiree de gemmyo.com : une barre utilitaire avec le logo centre,
  puis une rangee de navigation sous laquelle descend un panneau pleine largeur
  au survol. L'interet par rapport a l'ancien mega-menu suspendu sous chaque
  onglet, c'est que le panneau dispose de toute la largeur : on y met un visuel
  et des liens regroupes par intitule, au lieu d'une seule colonne.

  Le panneau s'ouvre au survol et au focus clavier ; theme.js ajoute en plus une
  bascule au clic sur les elements portant data-nav-submenu, pour le tactile.

  La navigation est ecrite en dur, comme le reste du theme — elle ne lit pas de
  menu Shopify. Les URL de l'espace Learn vivent aussi dans
  snippets/learn-nav.liquid pour sa sous-navigation : un handle qui change se
  corrige aux deux endroits.
{%- endcomment -%}

{%- liquid
  assign is_fr = false
  assign is_pt = false
  if request.locale.iso_code contains 'fr'
    assign is_fr = true
  endif
  if request.locale.iso_code contains 'pt'
    assign is_pt = true
  endif
-%}

<header class="site-header">
  <div class="site-header__proof" aria-label="Store benefits">
    <span>{% if is_fr %}Livraison rapide{% elsif is_pt %}Envio rapido{% else %}Fast shipping{% endif %}</span>
    <span>{% if is_fr %}Essai 30 jours{% elsif is_pt %}Teste de 30 dias{% else %}30-day trial{% endif %}</span>
    <span>{% if is_fr %}Garantie 2 ans{% elsif is_pt %}Garantia de 2 anos{% else %}2-year warranty{% endif %}</span>
  </div>

  <div class="container site-header__bar">
    <div class="site-header__utils site-header__utils--start">
      {%- if localization.available_languages.size > 1 -%}
        {% form 'localization', class: 'site-header__language-form' %}
          <label class="visually-hidden" for="HeaderLanguageSelector">Language</label>
          <select id="HeaderLanguageSelector" class="site-header__language-select" name="locale_code" onchange="this.form.submit()">
            {%- for language in localization.available_languages -%}
              <option value="{{ language.iso_code }}" {% if language.iso_code == localization.language.iso_code %}selected{% endif %}>
                {{ language.iso_code | upcase }}
              </option>
            {%- endfor -%}
          </select>
        {% endform %}
      {%- else -%}
        <span class="site-header__language-static" aria-label="Current language">
          {{ localization.language.iso_code | default: request.locale.iso_code | upcase }}
        </span>
      {%- endif -%}
      <a class="site-header__util-link" href="/pages/find-your-cytolight">{% if is_fr %}Trouvez votre CytoLight{% elsif is_pt %}Encontre seu CytoLight{% else %}Find Your CytoLight{% endif %}</a>
      <a class="site-header__util-link" href="/pages/contact">{% if is_fr %}Nous contacter{% elsif is_pt %}Contacte-nos{% else %}Contact us{% endif %}</a>
    </div>

    <a class="site-header__logo" href="{{ routes.root_url }}">
      {%- comment -%}
        height="auto" n'est pas une valeur valide pour l'attribut : le navigateur
        l'ignore, ne connait plus le ratio et decale la mise en page a l'arrivee
        de l'image. La hauteur est calculee depuis le ratio reel du fichier.
      {%- endcomment -%}
      {%- if section.settings.logo != blank -%}
        <img src="{{ section.settings.logo | image_url: width: 340 }}"
             width="170" height="{{ 170 | divided_by: section.settings.logo.aspect_ratio | round }}"
             alt="CytoLight" fetchpriority="high">
      {%- else -%}
        <img src="{{ 'cytolight-logo.jpg' | file_url }}"
             width="170" height="62"
             alt="CytoLight" fetchpriority="high">
      {%- endif -%}
    </a>

    <div class="site-header__utils site-header__utils--end">
      <a class="site-header__icon" href="{{ routes.search_url }}" aria-label="{% if is_fr %}Rechercher{% elsif is_pt %}Pesquisar{% else %}Search{% endif %}">
        {% render 'icon', name: 'search' %}
      </a>
      <a class="site-header__icon" href="{{ routes.account_url }}" aria-label="{% if is_fr %}Mon compte{% elsif is_pt %}Minha conta{% else %}Account{% endif %}">
        {% render 'icon', name: 'user' %}
      </a>
      {%- comment -%}
        Le nom accessible doit contenir le texte visible, ici le compteur, sinon
        la commande vocale "cliquer sur Panier" ne trouve pas la cible
        (WCAG 2.5.3, echec label-content-name-mismatch).
      {%- endcomment -%}
      <a class="site-header__icon" href="{{ routes.cart_url }}" aria-label="{% if is_fr %}Panier, {{ cart.item_count }} article{% if cart.item_count > 1 %}s{% endif %}{% elsif is_pt %}Carrinho, {{ cart.item_count }} artigo{% if cart.item_count > 1 %}s{% endif %}{% else %}Cart, {{ cart.item_count }} item{% if cart.item_count > 1 %}s{% endif %}{% endif %}">
        {% render 'icon', name: 'cart' %}
        <span class="site-header__cart-count">{{ cart.item_count }}</span>
      </a>
    </div>
  </div>

