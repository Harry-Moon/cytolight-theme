{%- liquid
  assign is_fr = false
  if request.locale.iso_code contains 'fr'
    assign is_fr = true
  endif

  assign desk_product = section.settings.featured_product
  if desk_product == blank
    assign desk_product = all_products['cytolight-desk']
  endif

  assign desk_url = '/products/cytolight-desk'
  if desk_product != blank
    assign desk_url = desk_product.url
  endif

  assign product_collection = section.settings.product_collection

  assign cap_product = all_products['cytolight-cap']
  assign cap_url = '/products/cytolight-cap'
  if cap_product != blank
    assign cap_url = cap_product.url
  endif

  assign pano_ultra_product = all_products['cytolight-pano-ultra']
  assign pano_ultra_url = '/products/cytolight-pano-ultra'
  if pano_ultra_product != blank
    assign pano_ultra_url = pano_ultra_product.url
  endif

  assign foot_product = all_products['cytolight-foot']
  assign foot_url = '/products/cytolight-foot'
  if foot_product != blank
    assign foot_url = foot_product.url
  endif

  assign mask_product = all_products['cytolight-mask']
  assign mask_url = '/products/cytolight-mask'
  if mask_product != blank
    assign mask_url = mask_product.url
  endif

  assign knee_product = all_products['cytolight-knee']
  assign knee_url = '/products/cytolight-knee'
  if knee_product != blank
    assign knee_url = knee_product.url
  endif

  assign sauna_dome_product = all_products['cytolight-sauna-dome']
  assign sauna_dome_url = '/products/cytolight-sauna-dome'
  if sauna_dome_product != blank
    assign sauna_dome_url = sauna_dome_product.url
  endif
-%}

{{ 'cytolight-cinematic.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cytolight-cinematic.js' | asset_url }}" defer></script>

<main class="cy-home" data-cytolight-home>
  <section class="cy-hero" aria-labelledby="cy-home-title">
    <div class="cy-hero__media" aria-hidden="true">
      <video src="{{ section.settings.hero_video_url | default: 'https://media.paretophysio.com/videos/ouided/Luxury.mp4' }}" autoplay loop muted playsinline preload="metadata"></video>
    </div>
    <div class="cy-hero__content">
      <div class="cy-shell">
        <p class="cy-hero__brand">CytoLight</p>
        <h1 id="cy-home-title">
          {%- if is_fr -%}
            {{ section.settings.hero_heading_fr | default: 'La lumi&egrave;re qui transforme votre quotidien.' }}
          {%- else -%}
            {{ section.settings.hero_heading_en | default: 'Light that transforms your everyday.' }}
          {%- endif -%}
        </h1>
        <p class="cy-hero__sub">
          {%- if is_fr -%}
            {{ section.settings.hero_text_fr | default: 'Des syst&egrave;mes de luminoth&eacute;rapie rouge intelligents, con&ccedil;us pour la r&eacute;cup&eacute;ration, la peau, le sommeil et l&apos;&eacute;nergie.' }}
          {%- else -%}
            {{ section.settings.hero_text_en | default: 'Intelligent red light therapy systems designed for recovery, skin, sleep, and energy.' }}
          {%- endif -%}
        </p>
        <div class="cy-actions">
          <a class="cy-button cy-button--light" href="{{ section.settings.primary_cta_url | default: desk_url }}">
            {%- if is_fr -%}{{ section.settings.primary_cta_fr | default: 'D&eacute;couvrir CytoLight DESK' }}{%- else -%}{{ section.settings.primary_cta_en | default: 'Discover CytoLight DESK' }}{%- endif -%}
          </a>
          <a class="cy-button cy-button--line" href="{{ section.settings.secondary_cta_url | default: '#cy-range' }}">
            {%- if is_fr -%}{{ section.settings.secondary_cta_fr | default: 'Voir la gamme' }}{%- else -%}{{ section.settings.secondary_cta_en | default: 'Explore the range' }}{%- endif -%}
          </a>
        </div>

        <div class="cy-hero__facts" aria-label="{% if is_fr %}Points cl&eacute;s{% else %}Key facts{% endif %}">
          {%- assign fact_blocks = section.blocks | where: 'type', 'technical_fact' -%}
          {%- if fact_blocks.size > 0 -%}
            {%- for block in fact_blocks limit: 4 -%}
              <div class="cy-hero__fact" {{ block.shopify_attributes }}>
                <strong>{{ block.settings.value }}</strong>
                <span>{% if is_fr %}{{ block.settings.label_fr }}{% else %}{{ block.settings.label_en }}{% endif %}</span>
              </div>
            {%- endfor -%}
          {%- else -%}
            <div class="cy-hero__fact"><strong>7</strong><span>{% if is_fr %}longueurs d'onde cibl&eacute;es{% else %}targeted wavelengths{% endif %}</span></div>
            <div class="cy-hero__fact"><strong>590-940</strong><span>{% if is_fr %}nm, de l'ambre au NIR profond{% else %}nm, amber to deep NIR{% endif %}</span></div>
            <div class="cy-hero__fact"><strong>1-40 Hz</strong><span>{% if is_fr %}pulsations configurables{% else %}configurable pulsing{% endif %}</span></div>
            <div class="cy-hero__fact"><strong>30 {% if is_fr %}jours{% else %}days{% endif %}</strong><span>{% if is_fr %}pour l'essayer chez vous{% else %}to try it at home{% endif %}</span></div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>

  <section class="cy-cinema" data-cy-cinema id="cy-science">
    <div class="cy-cinema__stage">
      <div class="cy-cinema__world">
        <img src="{{ 'cytolight-desk-luxury.jpg' | file_url }}" alt="{% if is_fr %}CytoLight DESK en luminoth&eacute;rapie rouge{% else %}CytoLight DESK red light therapy panel{% endif %}" width="1600" height="900" loading="lazy">
        <span class="cy-cinema__glow" aria-hidden="true"></span>
      </div>
      <div class="cy-cinema__panel">
        <div class="cy-cinema__lead">
          <p class="cy-kicker cy-cinema__title-a">{% if is_fr %}Sept spectres, un seul syst&egrave;me{% else %}Seven spectra, one system{% endif %}</p>
          <h2 class="cy-cinema__title-b">{% if is_fr %}La bonne lumi&egrave;re. Au bon moment.{% else %}The right light. At the right time.{% endif %}</h2>
        </div>
        <p class="cy-cinema__body">{% if is_fr %}De l'ambre au proche infrarouge profond, chaque longueur d'onde r&eacute;pond &agrave; un besoin diff&eacute;rent. CytoLight DESK vous permet de les utiliser ensemble ou de les ajuster individuellement depuis l'&eacute;cran tactile et l'application.{% else %}From amber to deep near-infrared, each wavelength serves a different purpose. CytoLight DESK lets you use them together or tune them individually from its touchscreen and app.{% endif %}</p>
        <div class="cy-spectrum cy-reveal" aria-label="{% if is_fr %}Longueurs d'onde{% else %}Wavelengths{% endif %}">
          <span style="--wave-color:#ffb347;--wave-glow:rgba(255,179,71,.55)"><strong>590</strong>Amber</span><span style="--wave-color:#e8303a;--wave-glow:rgba(232,48,58,.55)"><strong>630</strong>Red</span><span style="--wave-color:#c8102e;--wave-glow:rgba(200,16,46,.55)"><strong>660</strong>Deep red</span>
          <span style="--wave-color:#7b4fa6;--wave-glow:rgba(123,79,166,.55)"><strong>810</strong>NIR</span><span style="--wave-color:#6a3d9a;--wave-glow:rgba(106,61,154,.55)"><strong>830</strong>NIR</span><span style="--wave-color:#5b2d8e;--wave-glow:rgba(91,45,142,.55)"><strong>850</strong>NIR</span><span style="--wave-color:#3d1f6e;--wave-glow:rgba(61,31,110,.55)"><strong>940</strong>Deep NIR</span>
        </div>
      </div>
    </div>
  </section>

  <section class="cy-cinema cy-cinema--cap" data-cy-cinema id="cy-cap-ritual">
    <div class="cy-cinema__stage">
      <div class="cy-cinema__world">
        <video src="https://cdn.shopify.com/videos/c/o/v/6a9ef77bf5f84b87aa84e0f43685a21b.mp4" autoplay loop muted playsinline aria-hidden="true"></video>
        <span class="cy-cinema__glow" aria-hidden="true"></span>
      </div>
      <div class="cy-cinema__panel">
        <div class="cy-cinema__lead">
          <p class="cy-kicker cy-cinema__title-a">{% if is_fr %}CytoLight Redlight Cap{% else %}CytoLight Redlight Cap{% endif %}</p>
          <h2 class="cy-cinema__title-b">{% if is_fr %}La routine cheveux que vous pouvez vraiment garder.{% else %}The hair ritual you can actually keep.{% endif %}</h2>
        </div>
        <p class="cy-cinema__body">{% if is_fr %}Une casquette de luminoth&eacute;rapie rouge et proche infrarouge, pens&eacute;e pour rester proche du cuir chevelu pendant que vous lisez, travaillez ou vous d&eacute;tendez. Moins d'effort. Plus de r&eacute;gularit&eacute;.{% else %}A red and near-infrared light therapy cap designed to stay close to the scalp while you read, work, or unwind. Less friction. More consistency.{% endif %}</p>
        <div class="cy-cap-points cy-reveal" aria-label="{% if is_fr %}B&eacute;n&eacute;fices CytoLight Cap{% else %}CytoLight Cap benefits{% endif %}">
          <span>{% if is_fr %}Format mains libres{% else %}Hands-free format{% endif %}</span>
          <span>660nm + 850nm</span>
          <span>{% if is_fr %}150 LED 3-en-1{% else %}150 3-in-1 LEDs{% endif %}</span>
        </div>
        <div class="cy-actions">
          <a class="cy-button cy-button--light" href="/products/cytolight-cap">{% if is_fr %}D&eacute;couvrir la casquette{% else %}Discover the cap{% endif %}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="cy-cinema cy-cinema--pano" data-cy-cinema id="cy-pano-ultra">
    <div class="cy-cinema__stage">
      <div class="cy-cinema__world">
        <img src="{{ 'cytolight-pano-ultra-athlete.jpg' | file_url }}" alt="CytoLight PANO ULTRA with athlete recovery routine" width="1600" height="900" loading="lazy">
        <span class="cy-cinema__glow" aria-hidden="true"></span>
      </div>
      <div class="cy-cinema__panel">
        <p class="cy-kicker">CytoLight PANO ULTRA</p>
        <h2>{% if is_fr %}Une exp&eacute;rience lumineuse grand format.{% else %}A larger light experience for serious routines.{% endif %}</h2>
        <p>{% if is_fr %}Pens&eacute; pour les espaces wellness, les studios et les routines corps entier, PANO ULTRA apporte une pr&eacute;sence plus immersive tout en gardant l'ADN CytoLight : design premium, usage simple et lumi&egrave;re cibl&eacute;e.{% else %}Designed for wellness spaces, studios, and full-body routines, PANO ULTRA brings a more immersive presence while keeping the CytoLight DNA: premium design, simple use, and targeted light.{% endif %}</p>
        <div class="cy-cap-points cy-reveal" aria-label="{% if is_fr %}Points forts PANO ULTRA{% else %}PANO ULTRA highlights{% endif %}">
          <span>{% if is_fr %}Format grand panneau{% else %}Large panel format{% endif %}</span>
          <span>{% if is_fr %}Couverture corps entier{% else %}Full-body coverage{% endif %}</span>
          <span>{% if is_fr %}Disponible en ligne{% else %}Online ready{% endif %}</span>
        </div>
        <div class="cy-actions">
          <a class="cy-button cy-button--light" href="{{ pano_ultra_url }}">{% if is_fr %}Acheter PANO ULTRA{% else %}Buy PANO ULTRA{% endif %}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="cy-intro cy-reveal">
    <div class="cy-shell cy-intro__top">
      <div>
        <p class="cy-kicker">{% if is_fr %}Le bien-&ecirc;tre, redessin&eacute;{% else %}Wellness, redesigned{% endif %}</p>
        <h2 class="cy-heading">{% if is_fr %}Une technologie avanc&eacute;e. Une exp&eacute;rience remarquablement simple.{% else %}Advanced technology. A remarkably simple experience.{% endif %}</h2>
      </div>
      <div class="cy-intro__aside">
        <p>{% if is_fr %}CytoLight r&eacute;unit puissance, contr&ocirc;le spectral et design pour faire de la luminoth&eacute;rapie un rituel que vous avez vraiment envie de garder.{% else %}CytoLight brings together power, spectral control, and considered design to make light therapy a ritual you will actually keep.{% endif %}</p>
        <a class="cy-link" href="#cy-science">{% if is_fr %}Comprendre la technologie{% else %}Understand the technology{% endif %} <span aria-hidden="true">&rarr;</span></a>
      </div>
    </div>
  </section>

  <section class="cy-range" id="cy-range">
    <div class="cy-shell">
      <div class="cy-range__head cy-reveal">
        <div>
          <p class="cy-kicker">{% if is_fr %}Catalogue CytoLight{% else %}CytoLight catalogue{% endif %}</p>
          <h2 class="cy-heading">{% if is_fr %}Choisissez la lumi&egrave;re faite pour votre espace.{% else %}Choose the light built for your space.{% endif %}</h2>
        </div>
        <div class="cy-range__aside">
          <p>{% if is_fr %}Du bureau personnel au studio wellness, comparez la gamme CytoLight en un coup d'oeil et trouvez le format qui correspond &agrave; votre rituel.{% else %}From a personal desk ritual to a full wellness studio, compare the CytoLight range at a glance and find the format that fits your routine.{% endif %}</p>
          <a class="cy-link" href="{{ routes.all_products_collection_url }}">{% if is_fr %}Voir tous les produits{% else %}View all products{% endif %} <span aria-hidden="true">&rarr;</span></a>
        </div>
      </div>
      <div class="cy-products">
        <a class="cy-product cy-reveal" href="{{ desk_url }}">
          <span class="cy-product__media"><img src="{{ 'cytolight-desk-luxury.jpg' | file_url }}" alt="CytoLight DESK" width="900" height="1100" loading="lazy"></span>
          <span class="cy-product__content">
            <span class="cy-product__type">{% if is_fr %}Personnel &middot; Bureau{% else %}Personal &middot; Desktop{% endif %}</span>
            <h3>CytoLight DESK</h3>
            <span class="cy-product__desc">{% if is_fr %}Le panneau compact &agrave; 7 spectres pour votre routine quotidienne.{% else %}The compact 7-spectrum panel for your daily routine.{% endif %}</span>
            <span class="cy-product__meta">
              <span class="cy-product__price">{% if desk_product != blank %}{{ desk_product.price | money }}{% else %}299 EUR{% endif %}</span>
              <span class="cy-link">{% if is_fr %}D&eacute;couvrir{% else %}Discover{% endif %} &rarr;</span>
            </span>
          </span>
        </a>

        <a class="cy-product cy-reveal" href="{{ cap_url }}">
          <span class="cy-product__media"><img src="{{ 'cytolight-cap-ambiance.jpg' | file_url }}" alt="CytoLight Redlight Cap" width="900" height="1100" loading="lazy"></span>
          <span class="cy-product__content">
            <span class="cy-product__type">{% if is_fr %}Cheveux &middot; Mains libres{% else %}Hair &middot; Hands-free{% endif %}</span>
            <h3>CytoLight Redlight Cap</h3>
            <span class="cy-product__desc">{% if is_fr %}Routine cuir chevelu simple et facile &agrave; garder.{% else %}A simple scalp routine that is easy to keep.{% endif %}</span>
            <span class="cy-product__meta">
              <span class="cy-product__price">{% if cap_product != blank %}{{ cap_product.price | money }}{% else %}330 EUR{% endif %}</span>
              <span class="cy-link">{% if is_fr %}D&eacute;couvrir{% else %}Discover{% endif %} &rarr;</span>
            </span>
          </span>
        </a>

        <a class="cy-product cy-reveal" href="{{ mask_url }}">
          <span class="cy-product__media"><video src="https://cdn.shopify.com/videos/c/o/v/6e729ca4196441df8bb75480e0ddb070.mp4" autoplay loop muted playsinline aria-hidden="true"></video></span>
          <span class="cy-product__content">
            <span class="cy-product__type">{% if is_fr %}Visage &middot; Beaut&eacute;{% else %}Face &middot; Beauty{% endif %}</span>
            <h3>CytoLight Mask</h3>
            <span class="cy-product__desc">{% if is_fr %}Masque LED souple pour une routine visage courte.{% else %}A flexible LED mask for a short face routine.{% endif %}</span>
            <span class="cy-product__meta">
              <span class="cy-product__price">{% if mask_product != blank %}{{ mask_product.price | money }}{% else %}250 EUR{% endif %}</span>
              <span class="cy-link">{% if is_fr %}D&eacute;couvrir{% else %}Discover{% endif %} &rarr;</span>
            </span>
          </span>
        </a>

        <a class="cy-product cy-reveal" href="{{ foot_url }}">
          <span class="cy-product__media">
            {%- if foot_product.featured_image -%}
              <img src="{{ foot_product.featured_image | image_url: width: 900 }}" alt="{{ foot_product.featured_image.alt | escape }}" width="900" height="1100" loading="lazy">
            {%- else -%}
              <img src="{{ 'cytolight-desk-luxury.jpg' | file_url }}" alt="CytoLight Foot Therapy" width="900" height="1100" loading="lazy">
            {%- endif -%}
          </span>
          <span class="cy-product__content">
            <span class="cy-product__type">{% if is_fr %}Pieds &middot; R&eacute;cup&eacute;ration{% else %}Feet &middot; Recovery{% endif %}</span>
            <h3>CytoLight Foot</h3>
            <span class="cy-product__desc">{% if is_fr %}Pour les pieds fatigu&eacute;s et les routines &agrave; domicile.{% else %}For tired feet and simple at-home routines.{% endif %}</span>
            <span class="cy-product__meta">
              <span class="cy-product__price">{% if foot_product != blank %}{{ foot_product.price | money }}{% else %}220 EUR{% endif %}</span>
              <span class="cy-link">{% if is_fr %}D&eacute;couvrir{% else %}Discover{% endif %} &rarr;</span>
            </span>
          </span>
        </a>

        <a class="cy-product cy-reveal" href="{{ knee_url }}">
          <span class="cy-product__media">
            {%- if knee_product.featured_image -%}
              <img src="{{ knee_product.featured_image | image_url: width: 900 }}" alt="{{ knee_product.featured_image.alt | escape }}" width="900" height="1100" loading="lazy">
            {%- else -%}
              <img src="{{ 'cytolight-desk-luxury.jpg' | file_url }}" alt="CytoLight Knee Therapy" width="900" height="1100" loading="lazy">
            {%- endif -%}
          </span>
          <span class="cy-product__content">
            <span class="cy-product__type">{% if is_fr %}Genou &middot; R&eacute;cup&eacute;ration{% else %}Knee &middot; Recovery{% endif %}</span>
            <h3>CytoLight Knee</h3>
            <span class="cy-product__desc">{% if is_fr %}Pour l'articulation du genou et le confort &agrave; domicile.{% else %}For the knee joint and simple at-home comfort.{% endif %}</span>
            <span class="cy-product__meta">
              <span class="cy-product__price">{% if knee_product != blank %}{{ knee_product.price | money }}{% else %}250 EUR{% endif %}</span>
              <span class="cy-link">{% if is_fr %}D&eacute;couvrir{% else %}Discover{% endif %} &rarr;</span>
            </span>
          </span>
        </a>

        <a class="cy-product cy-reveal" href="{{ sauna_dome_url }}">
          <span class="cy-product__media"><img src="{{ 'Cytolight_Sauna_Dome_2.jpg' | file_url }}" alt="CytoLight Sauna Dome" width="900" height="1100" loading="lazy"></span>
          <span class="cy-product__content">
            <span class="cy-product__type">{% if is_fr %}Corps entier &middot; R&eacute;cup&eacute;ration{% else %}Full Body &middot; Recovery{% endif %}</span>
            <h3>CytoLight Sauna Dome</h3>
            <span class="cy-product__desc">{% if is_fr %}Lumi&egrave;re, chaleur et PEMF pour une session compl&egrave;te.{% else %}Light, heat, and PEMF for a complete session.{% endif %}</span>
            <span class="cy-product__meta">
              <span class="cy-product__price">{% if sauna_dome_product != blank %}{{ sauna_dome_product.price | money }}{% else %}1997 EUR{% endif %}</span>
              <span class="cy-link">{% if is_fr %}D&eacute;couvrir{% else %}Discover{% endif %} &rarr;</span>
            </span>
          </span>
        </a>

        <a class="cy-product cy-reveal" href="{{ pano_ultra_url }}">
          <span class="cy-product__media"><img src="{{ 'cytolight-pano-ultra-luxury.jpg' | file_url }}" alt="CytoLight PANO ULTRA" width="900" height="1100" loading="lazy"></span>
          <span class="cy-product__content">
            <span class="cy-product__type">{% if is_fr %}Performance &middot; Professionnel{% else %}Performance &middot; Professional{% endif %}</span>
            <h3>CytoLight PANO ULTRA</h3>
            <span class="cy-product__desc">{% if is_fr %}Panneau grand format pour routines corps entier.{% else %}Large-format panel for full-body routines.{% endif %}</span>
            <span class="cy-product__meta">
              <span class="cy-product__price">{% if pano_ultra_product != blank %}{{ pano_ultra_product.price | money }}{% else %}1500 EUR{% endif %}</span>
              <span class="cy-link">{% if is_fr %}D&eacute;couvrir{% else %}Discover{% endif %} &rarr;</span>
            </span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <section class="cy-use">
    <div class="cy-shell">
      <div class="cy-use__head cy-reveal">
        <p class="cy-kicker">{% if is_fr %}Acheter selon votre objectif{% else %}Shop by goal{% endif %}</p>
        <h2 class="cy-heading">{% if is_fr %}Commencez par le r&eacute;sultat que vous voulez ressentir.{% else %}Start with the result you want to feel.{% endif %}</h2>
      </div>
      <div class="cy-use__grid">
        {%- assign goal_blocks = section.blocks | where: 'type', 'goal' -%}
        {%- if goal_blocks.size > 0 -%}
          {%- for block in goal_blocks -%}
            {%- liquid
              assign goal_image = 'cytolight-desk-luxury.jpg'
              assign goal_alt = 'CytoLight desk ritual'
              case forloop.index
                when 1
                  assign goal_image = 'cytolight-goal-recovery-pano-athlete.jpg'
                  assign goal_alt = 'CytoLight recovery routine'
                when 2
                  assign goal_image = 'cytolight-goal-skin-red-halo.jpg'
                  assign goal_alt = 'CytoLight skin and glow routine'
                when 3
                  assign goal_image = 'cytolight-desk-luxury.jpg'
                  assign goal_alt = 'CytoLight focus ritual'
                when 4
                  assign goal_image = 'cytolight-goal-sleep-pano-bedroom.jpg'
                  assign goal_alt = 'CytoLight evening routine'
              endcase
            -%}
            <a class="cy-use__item cy-reveal" href="{{ block.settings.url | default: desk_url }}" {{ block.shopify_attributes }}>
              <span class="cy-use__media"><img src="{{ goal_image | file_url }}" alt="{{ goal_alt }}" width="900" height="720" loading="lazy"></span>
              <span class="cy-use__content">
                <span class="cy-use__num">0{{ forloop.index }}</span>
                <h3>{% if is_fr %}{{ block.settings.title_fr }}{% else %}{{ block.settings.title_en }}{% endif %}</h3>
                <p>{% if is_fr %}{{ block.settings.text_fr }}{% else %}{{ block.settings.text_en }}{% endif %}</p>
              </span>
            </a>
          {%- endfor -%}
        {%- else -%}
          <a class="cy-use__item cy-reveal" href="{{ desk_url }}"><span class="cy-use__media"><img src="{{ 'cytolight-goal-recovery-pano-athlete.jpg' | file_url }}" alt="{% if is_fr %}Routine de r&eacute;cup&eacute;ration CytoLight{% else %}CytoLight recovery routine{% endif %}" width="900" height="720" loading="lazy"></span><span class="cy-use__content"><span class="cy-use__num">01</span><h3>{% if is_fr %}R&eacute;cup&eacute;ration{% else %}Recovery{% endif %}</h3><p>{% if is_fr %}Pour les muscles, articulations et routines apr&egrave;s effort.{% else %}For muscles, joints, and post-effort routines.{% endif %}</p></span></a>
