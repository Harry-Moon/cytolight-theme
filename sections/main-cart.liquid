<section class="container">
  {% if cart.item_count > 0 %}
    <div class="cart">
      <form action="{{ routes.cart_url }}" method="post" novalidate class="cart__form">
        <h1>{% if request.locale.iso_code contains 'fr' %}Votre panier{% else %}Your cart{% endif %}</h1>
        <div class="cart__items">
          {% for item in cart.items %}
            <div class="cart-item" data-line="{{ forloop.index }}">
              <a href="{{ item.url }}" class="cart-item__img">
                {% if item.image != blank %}
                  <img src="{{ item.image | image_url: width: 240 }}" alt="{{ item.title | escape }}">
                {% endif %}
              </a>
              <div>
                <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title }}</a>
                {% unless item.product.has_only_default_variant %}
                  <div class="cart-item__variant">{{ item.variant.title }}</div>
                {% endunless %}
                <div class="product__qty" style="margin-top:10px;">
                  <button type="button" data-qty-step="-1">−</button>
                  <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" data-line-key="{{ item.key }}">
                  <button type="button" data-qty-step="1">+</button>
                </div>
                <a href="{{ item.url_to_remove }}" style="font-size:.8rem; color: var(--color-muted); margin-top:8px; display:inline-block;">{% if request.locale.iso_code contains 'fr' %}Retirer{% else %}Remove{% endif %}</a>
              </div>
              <div class="cart-item__price">{{ item.final_line_price | money }}</div>
            </div>
          {% endfor %}
        </div>
        <button type="submit" name="update" class="btn btn--ghost btn--sm" style="margin-top:16px;">{% if request.locale.iso_code contains 'fr' %}Mettre &agrave; jour le panier{% else %}Update cart{% endif %}</button>
      </form>

      <aside class="cart-summary">
        <div class="cart-summary__row"><span>{% if request.locale.iso_code contains 'fr' %}Sous-total{% else %}Subtotal{% endif %}</span><span>{{ cart.items_subtotal_price | money }}</span></div>
        {% if cart.cart_level_discount_applications.size > 0 %}
          {% for discount in cart.cart_level_discount_applications %}
            <div class="cart-summary__row"><span>{{ discount.title }}</span><span>−{{ discount.total_allocated_amount | money }}</span></div>
          {% endfor %}
        {% endif %}
        <div class="cart-summary__row cart-summary__total"><span>Total</span><span>{{ cart.total_price | money }}</span></div>
        <p style="font-size:.8rem; color: var(--color-muted); margin: 8px 0 0;">{% if request.locale.iso_code contains 'fr' %}Taxes et livraison calcul&eacute;es au paiement.{% else %}Taxes and shipping calculated at checkout.{% endif %}</p>
        <a href="{{ routes.cart_url }}/checkout" class="btn btn--primary">{% if request.locale.iso_code contains 'fr' %}Paiement{% else %}Checkout{% endif %} &rarr;</a>
        <p style="text-align:center; margin: 12px 0 0; font-size:.8rem;"><a href="{{ routes.all_products_collection_url }}">{% if request.locale.iso_code contains 'fr' %}Continuer mes achats{% else %}Continue shopping{% endif %}</a></p>
      </aside>
    </div>
  {% else %}
    <div class="cart-empty">
      <h1>{% if request.locale.iso_code contains 'fr' %}Votre panier est vide{% else %}Your cart is empty{% endif %}</h1>
      <p style="color: var(--color-muted);">{% if request.locale.iso_code contains 'fr' %}D&eacute;couvrez nos meilleures ventes et commencez votre rituel bien-&ecirc;tre.{% else %}Discover our best sellers and start your wellness ritual.{% endif %}</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary" style="margin-top:16px;">{% if request.locale.iso_code contains 'fr' %}Voir les meilleures ventes{% else %}Shop best sellers{% endif %} &rarr;</a>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Cart",
  "tag": "section",
  "settings": []
}
{% endschema %}
