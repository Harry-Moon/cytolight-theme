<footer class="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <h3>CYTOLIGHT</h3>
        <p>{% if request.locale.iso_code contains 'fr' %}Technologies bien-&ecirc;tre inspir&eacute;es par la science pour accompagner le sommeil, la r&eacute;cup&eacute;ration et l'&eacute;clat de la peau.{% else %}{{ section.settings.tagline | default: "Science-backed wellness technologies to enhance sleep, recovery, and beauty." }}{% endif %}</p>
        <div class="site-footer__socials">
          {% if section.settings.instagram != blank %}<a href="{{ section.settings.instagram }}" aria-label="Instagram">{% render 'icon', name: 'instagram' %}</a>{% endif %}
          {% if section.settings.facebook != blank %}<a href="{{ section.settings.facebook }}" aria-label="Facebook">{% render 'icon', name: 'facebook' %}</a>{% endif %}
          {% if section.settings.tiktok != blank %}<a href="{{ section.settings.tiktok }}" aria-label="TikTok">{% render 'icon', name: 'tiktok' %}</a>{% endif %}
          {% if section.settings.youtube != blank %}<a href="{{ section.settings.youtube }}" aria-label="YouTube">{% render 'icon', name: 'youtube' %}</a>{% endif %}
        </div>
      </div>

      {% for block in section.blocks %}
        {% if block.type == 'menu_column' %}
          <div class="site-footer__col" {{ block.shopify_attributes }}>
            <h4>{{ block.settings.heading | escape }}</h4>
            <ul>
              {% for link in linklists[block.settings.menu].links %}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {% endfor %}
            </ul>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <div class="site-footer__bottom">
      <span>&copy; {{ 'now' | date: "%Y" }} CytoLight. {% if request.locale.iso_code contains 'fr' %}Tous droits r&eacute;serv&eacute;s.{% else %}All rights reserved.{% endif %}</span>
      <span>{{ shop.address.country }} · {{ cart.currency.iso_code }}</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "textarea", "id": "tagline", "label": "Tagline" },
    { "type": "url", "id": "instagram", "label": "Instagram URL" },
    { "type": "url", "id": "facebook", "label": "Facebook URL" },
    { "type": "url", "id": "tiktok", "label": "TikTok URL" },
    { "type": "url", "id": "youtube", "label": "YouTube URL" }
  ],
  "blocks": [
    {
      "type": "menu_column",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    }
  ],
  "max_blocks": 7,
  "default": {
    "blocks": [
      { "type": "menu_column", "settings": { "heading": "Shop", "menu": "footer-shop" } },
      { "type": "menu_column", "settings": { "heading": "Discover", "menu": "footer-discover" } },
      { "type": "menu_column", "settings": { "heading": "Learn", "menu": "footer-learn" } },
      { "type": "menu_column", "settings": { "heading": "Professionals", "menu": "footer-professionals" } },
      { "type": "menu_column", "settings": { "heading": "Support", "menu": "footer-support" } },
      { "type": "menu_column", "settings": { "heading": "Company", "menu": "footer-company" } },
      { "type": "menu_column", "settings": { "heading": "Legal", "menu": "footer-legal" } }
    ]
  }
}
{% endschema %}
