{% comment %}
  ============================================================
  VitalGlow Homepage Section — Inspired by PlatinumLED
  Compatible with: Shopify Dawn / any base theme
  Customise all content via Shopify Theme Editor
  ============================================================
{% endcomment %}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800;900&display=swap');

  :root {
    --vg-font: 'Poppins', -apple-system, sans-serif;
    --vg-bg:          #0a0a0a;
    --vg-bg2:         #111111;
    --vg-bg3:         #161616;
    --vg-accent:      #c8102e;
    --vg-accent-dark: #9a0c22;
    --vg-accent-glow: rgba(200,16,46,0.18);
    --vg-text:        #ffffff;
    --vg-text-muted:  #9a9a9a;
    --vg-text-dim:    #555;
    --vg-border:      #1e1e1e;
    --vg-border-light:#2a2a2a;
    --vg-radius:      6px;
    --vg-radius-lg:   12px;
  }

  .vg-page { background: var(--vg-bg); color: var(--vg-text); font-family: var(--vg-font); }

  .vg-section        { padding: 100px 48px; }
  .vg-section--alt   { background: var(--vg-bg2); }
  .vg-section--alt2  { background: var(--vg-bg3); }
  .vg-inner          { max-width: 1200px; margin: 0 auto; }
  .vg-inner--sm      { max-width: 900px; margin: 0 auto; }
  .vg-inner--md      { max-width: 1100px; margin: 0 auto; }
  .vg-center         { text-align: center; }

  .vg-label {
    font-size: 11px; font-weight: 700; letter-spacing: .2em;
    text-transform: uppercase; color: var(--vg-accent); margin-bottom: 16px;
  }
  .vg-title {
    font-size: clamp(32px, 4.5vw, 58px); font-weight: 800;
    line-height: 1.08; letter-spacing: -.025em;
  }
  .vg-title em { font-style: normal; color: var(--vg-accent); }
  .vg-subtitle {
    font-size: 16px; color: var(--vg-text-muted);
    max-width: 580px; margin-top: 14px; line-height: 1.75;
  }
  .vg-center .vg-subtitle { margin-left: auto; margin-right: auto; }

  .vg-btn {
    display: inline-block;
    background: var(--vg-accent); color: #fff;
    padding: 15px 38px; border-radius: var(--vg-radius);
    font-weight: 700; font-size: 13.5px; letter-spacing: .08em;
    text-transform: uppercase; text-decoration: none;
    transition: background .2s, transform .15s; border: none; cursor: pointer;
  }
  .vg-btn:hover { background: var(--vg-accent-dark); transform: translateY(-1px); }

  .vg-btn--outline {
    display: inline-block;
    border: 1.5px solid rgba(255,255,255,.25); color: #fff;
    padding: 14px 34px; border-radius: var(--vg-radius);
    font-weight: 600; font-size: 13.5px; letter-spacing: .08em;
    text-transform: uppercase; text-decoration: none; background: transparent;
    transition: border-color .2s, background .2s; cursor: pointer;
  }
  .vg-btn--outline:hover { border-color: rgba(255,255,255,.5); background: rgba(255,255,255,.04); }

  .vg-hero {
    min-height: 92vh;
    background: #080808;
    display: flex; align-items: center; justify-content: center;
    text-align: center; padding: 80px 24px; position: relative; overflow: hidden;
  }
  .vg-hero__video {
    position: absolute; inset: 0; z-index: 0;
    width: 100%; height: 100%; overflow: hidden; background: #080808;
  }
  .vg-hero__video video {
    width: 100%; height: 100%; object-fit: cover;
    opacity: .94; transform: scale(1.01);
  }
  .vg-hero::before {
    content: '';
    position: absolute; inset: 0; z-index: 1;
    background:
      radial-gradient(ellipse 70% 48% at 50% 58%, rgba(200,16,46,.18), transparent 72%),
      linear-gradient(90deg, rgba(95,0,13,.34), rgba(10,10,10,.22) 48%, rgba(120,0,18,.3)),
      linear-gradient(180deg, rgba(0,0,0,.18), rgba(0,0,0,.38));
    pointer-events: none;
  }
  .vg-hero::after {
    content: '';
    position: absolute; inset: 0; z-index: 1;
    background: linear-gradient(180deg, rgba(0,0,0,.04), rgba(0,0,0,.28));
    pointer-events: none;
  }
  .vg-hero__inner { position: relative; z-index: 2; }
  .vg-hero__eyebrow {
    font-size: 12px; font-weight: 700; letter-spacing: .2em;
    text-transform: uppercase; color: var(--vg-accent); margin-bottom: 20px;
  }
  .vg-hero__h1 {
    font-size: clamp(52px, 8vw, 100px); font-weight: 900;
    line-height: 1; letter-spacing: -.03em; text-transform: uppercase; margin-bottom: 10px;
  }
  .vg-hero__h1 .outline-word {
    -webkit-text-stroke: 2px rgba(255,255,255,.22); color: transparent;
  }
  .vg-hero__h1 .accent-word { color: var(--vg-accent); }
  .vg-hero__sub {
    font-size: 17px; color: var(--vg-text-muted);
    max-width: 520px; margin: 24px auto 40px; line-height: 1.7;
  }
  .vg-hero__ctas { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; margin-bottom: 48px; }

  .vg-social-proof { display: flex; align-items: center; justify-content: center; gap: 14px; font-size: 13.5px; color: var(--vg-text-muted); margin-bottom: 40px; }
  .vg-avatar-stack { display: flex; }
  .vg-avatar-stack img { width: 36px; height: 36px; border-radius: 50%; border: 2px solid var(--vg-bg); margin-left: -8px; }
  .vg-avatar-stack img:first-child { margin-left: 0; }
  .vg-stars { color: #f5a623; font-size: 15px; }

  .vg-trust-badges { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
  .vg-badge {
    display: flex; align-items: center; gap: 8px;
    font-size: 11px; font-weight: 600; letter-spacing: .05em; text-transform: uppercase;
    color: var(--vg-text-muted); border: 1px solid var(--vg-border-light);
    padding: 8px 16px; border-radius: 30px;
  }
  .vg-badge__dot { width: 7px; height: 7px; border-radius: 50%; background: var(--vg-accent); }

  .vg-products-grid {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 24px; margin-top: 60px;
  }
  .vg-product-card {
    background: var(--vg-bg2); border: 1px solid var(--vg-border);
    border-radius: var(--vg-radius-lg); overflow: hidden;
    transition: border-color .25s, transform .25s;
  }
  .vg-product-card:hover { border-color: var(--vg-accent); transform: translateY(-3px); }
  .vg-product-card--featured { border-color: var(--vg-accent); }
  .vg-product-img {
    height: 280px; position: relative; overflow: hidden;
    display: flex; align-items: center; justify-content: center;
    background: linear-gradient(160deg, #1a0a0d, #0d0d0d);
  }
  .vg-product-img img { width: 100%; height: 100%; object-fit: cover; }
  .vg-product-tag { position: absolute; top: 16px; left: 16px; background: var(--vg-accent); color: #fff; font-size: 10px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; padding: 5px 12px; border-radius: 3px; }
  .vg-product-body { padding: 32px; }
  .vg-product-series { font-size: 10px; font-weight: 700; letter-spacing: .15em; text-transform: uppercase; color: var(--vg-accent); margin-bottom: 8px; }
  .vg-product-body h3 { font-size: 26px; font-weight: 800; letter-spacing: -.02em; margin-bottom: 10px; }
  .vg-product-body p { font-size: 14px; color: var(--vg-text-muted); line-height: 1.7; margin-bottom: 20px; }
  .vg-features { list-style: none; margin-bottom: 28px; }
  .vg-features li { display: flex; align-items: center; gap: 10px; font-size: 13.5px; color: var(--vg-text-muted); padding: 4px 0; }
  .vg-features li::before { content: 'v'; color: var(--vg-accent); font-weight: 700; flex-shrink: 0; }
  .vg-product-price { display: flex; align-items: baseline; gap: 8px; margin-bottom: 20px; }
  .vg-price-from { font-size: 13px; color: var(--vg-text-muted); }
  .vg-price-amount { font-size: 28px; font-weight: 800; }
  .vg-card-btn { display: block; width: 100%; text-align: center; padding: 14px; border-radius: var(--vg-radius); font-weight: 700; font-size: 13.5px; letter-spacing: .07em; text-transform: uppercase; }
  .vg-card-btn--solid { background: var(--vg-accent); color: #fff; transition: background .2s; }
  .vg-card-btn--solid:hover { background: var(--vg-accent-dark); }
  .vg-card-btn--border { border: 1.5px solid var(--vg-border-light); color: #fff; transition: border-color .2s; }
  .vg-card-btn--border:hover { border-color: rgba(255,255,255,.4); }

  .vg-compare { max-width: 1100px; margin: 60px auto 0; }
  .vg-tabs { display: flex; gap: 4px; background: var(--vg-bg2); border-radius: 8px; padding: 4px; width: fit-content; margin-bottom: 28px; }
  .vg-tab { padding: 9px 22px; border-radius: 5px; font-size: 13px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; cursor: pointer; color: var(--vg-text-muted); background: transparent; border: none; transition: background .2s, color .2s; }
  .vg-tab.active { background: var(--vg-accent); color: #fff; }
  .vg-table { width: 100%; border-collapse: collapse; }
  .vg-table th { background: var(--vg-bg2); font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--vg-text-muted); padding: 14px 20px; text-align: left; border-bottom: 1px solid var(--vg-border); }
  .vg-table td { padding: 14px 20px; font-size: 14px; color: var(--vg-text-muted); border-bottom: 1px solid var(--vg-border); }
  .vg-table td:first-child { color: var(--vg-text); font-weight: 600; }
  .vg-table tr:hover td { background: rgba(255,255,255,.02); }
  .vg-check { color: var(--vg-accent); }
  .vg-dash  { color: var(--vg-text-dim); }

  .vg-diff-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 28px; margin-top: 56px; }
  .vg-diff-card { background: var(--vg-bg); border: 1px solid var(--vg-border); border-radius: var(--vg-radius-lg); padding: 36px 32px; transition: border-color .25s; }
  .vg-diff-card:hover { border-color: var(--vg-accent); }
  .vg-diff-icon { width: 52px; height: 52px; background: var(--vg-accent-glow); border: 1px solid rgba(200,16,46,.3); border-radius: 10px; display: flex; align-items: center; justify-content: center; margin-bottom: 20px; color: var(--vg-accent); }
  .vg-diff-card h3 { font-size: 20px; font-weight: 700; margin-bottom: 10px; }
  .vg-diff-card p { font-size: 14px; color: var(--vg-text-muted); line-height: 1.75; }

  .vg-fit-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 20px; margin-top: 52px; }
  .vg-fit-card { background: var(--vg-bg2); border: 1px solid var(--vg-border); border-radius: var(--vg-radius-lg); overflow: hidden; transition: border-color .25s, transform .25s; }
  .vg-fit-card:hover { border-color: rgba(200,16,46,.5); transform: translateY(-4px); }
  .vg-fit-img { height: 180px; overflow: hidden; background: linear-gradient(135deg,#1a0a0d,#0d0d14); display: flex; align-items: center; justify-content: center; color: rgba(200,16,46,.7); }
  .vg-fit-img img { width: 100%; height: 100%; object-fit: cover; }
  .vg-fit-body { padding: 22px; }
  .vg-fit-body h4 { font-size: 17px; font-weight: 700; margin-bottom: 6px; }
  .vg-fit-body h4 em { font-style: normal; color: var(--vg-accent); }
  .vg-fit-body p { font-size: 13px; color: var(--vg-text-muted); margin-bottom: 14px; line-height: 1.6; }
  .vg-fit-link { font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--vg-accent); }

  .vg-benefits-scroll { display: flex; gap: 16px; overflow-x: auto; padding-bottom: 8px; margin-top: 44px; scrollbar-width: thin; scrollbar-color: var(--vg-border) transparent; }
  .vg-benefit-pill { background: var(--vg-bg2); border: 1px solid var(--vg-border); border-radius: 100px; padding: 12px 22px; display: flex; align-items: center; gap: 10px; white-space: nowrap; flex-shrink: 0; transition: border-color .2s, color .2s; color: var(--vg-text-muted); }
  .vg-benefit-pill:hover { border-color: var(--vg-accent); color: var(--vg-text); }
  .vg-benefit-pill .pill-icon { color: var(--vg-accent); }
  .vg-benefit-pill .pill-text { font-size: 13.5px; font-weight: 600; }

  .vg-testi-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 24px; margin-top: 52px; }
  .vg-testi-card { background: var(--vg-bg2); border: 1px solid var(--vg-border); border-radius: var(--vg-radius-lg); padding: 28px; }
  .vg-testi-stars { color: #f5a623; font-size: 14px; margin-bottom: 14px; }
  .vg-testi-text { font-size: 14.5px; line-height: 1.75; color: var(--vg-text-muted); margin-bottom: 20px; font-style: italic; }
  .vg-testi-author { display: flex; align-items: center; gap: 12px; }
  .vg-testi-avatar { width: 40px; height: 40px; border-radius: 50%; background: linear-gradient(135deg, var(--vg-accent-dark), #2a0a10); display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 15px; color: #fff; flex-shrink: 0; }
  .vg-testi-name { font-weight: 700; font-size: 14px; }
  .vg-testi-location { font-size: 12px; color: var(--vg-text-dim); }

  .vg-stats { display: flex; margin-top: 36px; border: 1px solid var(--vg-border); border-radius: var(--vg-radius-lg); overflow: hidden; }
  .vg-stat { flex: 1; padding: 28px 16px; text-align: center; border-right: 1px solid var(--vg-border); }
  .vg-stat:last-child { border-right: none; }
  .vg-stat__num { font-size: 30px; font-weight: 800; color: var(--vg-accent); }
  .vg-stat__label { font-size: 11px; color: var(--vg-text-muted); margin-top: 4px; font-weight: 600; text-transform: uppercase; letter-spacing: .06em; }

  .vg-email-wrap { display: flex; gap: 10px; justify-content: center; margin-top: 28px; max-width: 480px; margin-left: auto; margin-right: auto; flex-wrap: wrap; }
  .vg-email-input { flex: 1; min-width: 200px; background: var(--vg-bg2); border: 1px solid var(--vg-border-light); color: #fff; padding: 14px 18px; border-radius: var(--vg-radius); font-size: 14px; font-family: var(--vg-font); outline: none; transition: border-color .2s; }
  .vg-email-input:focus { border-color: var(--vg-accent); }

  @media (max-width: 900px) {
    .vg-section { padding: 72px 24px; }
    .vg-products-grid, .vg-diff-grid, .vg-testi-grid { grid-template-columns: 1fr; }
    .vg-fit-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 600px) {
    .vg-fit-grid { grid-template-columns: 1fr; }
    .vg-stats { flex-direction: column; }
    .vg-stat { border-right: none; border-bottom: 1px solid var(--vg-border); }
    .vg-stat:last-child { border-bottom: none; }
  }
</style>

<div class="vg-page">
  {%- assign is_fr = false -%}
  {%- if request.locale.iso_code contains 'fr' -%}
    {%- assign is_fr = true -%}
  {%- endif -%}

  <section class="vg-hero">
    <div class="vg-hero__video" aria-hidden="true">
      <video src="https://media.paretophysio.com/videos/ouided/Luxury.mp4" autoplay loop muted playsinline preload="metadata"></video>
    </div>
    <div class="vg-hero__inner">
      <div class="vg-hero__eyebrow">{% if is_fr %}Le nouveau standard du bien-&ecirc;tre{% else %}{{ section.settings.hero_eyebrow | default: 'The New Standard in Wellness' }}{% endif %}</div>
      <h1 class="vg-hero__h1">
        <span class="accent-word">{% if is_fr %}&Eacute;LEVEZ{% else %}{{ section.settings.hero_line1 | default: 'ELEVATE' }}{% endif %}</span><br/>
        <span class="outline-word">{% if is_fr %}VOTRE{% else %}{{ section.settings.hero_line2 | default: 'YOUR' }}{% endif %}</span><br/>
        {% if is_fr %}BIEN-&Ecirc;TRE{% else %}{{ section.settings.hero_line3 | default: 'WELLNESS' }}{% endif %}
      </h1>
      <p class="vg-hero__sub">{% if is_fr %}Inspir&eacute; par la science. Certifi&eacute;. Con&ccedil;u pour des r&eacute;sultats concrets au quotidien.{% else %}{{ section.settings.hero_subtext | default: 'Clinically inspired. Medically certified. Designed for real people who demand real results.' }}{% endif %}</p>
      <div class="vg-hero__ctas">
        <a href="{{ section.settings.hero_cta1_url | default: '/products/cytolight-desk' }}" class="vg-btn">{% if is_fr %}Acheter{% else %}{{ section.settings.hero_cta1_text | default: 'Shop Now' }}{% endif %}</a>
        <a href="{{ section.settings.hero_cta2_url | default: '/pages/the-science' }}" class="vg-btn--outline">{% if is_fr %}D&eacute;couvrir la science{% else %}{{ section.settings.hero_cta2_text | default: 'Explore the Science' }}{% endif %}</a>
      </div>
      <div class="vg-social-proof">
        <div class="vg-avatar-stack">
          {%- for i in (1..4) -%}
            <img src="https://i.pravatar.cc/72?img={{ i | times: 3 }}" alt="Customer" />
          {%- endfor -%}
        </div>
        <div>
          <div class="vg-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
          <span>{{ section.settings.hero_review_score | default: '4.95' }} &middot; {{ section.settings.hero_review_count | default: '2,800+' }} {% if is_fr %}avis{% else %}reviews{% endif %}</span>
        </div>
      </div>
      <div class="vg-trust-badges">
        {%- for block in section.blocks -%}
          {%- if block.type == 'trust_badge' -%}
            <div class="vg-badge" {{ block.shopify_attributes }}>
              <div class="vg-badge__dot"></div>
              {{ block.settings.badge_text }}
            </div>
          {%- endif -%}
        {%- endfor -%}
        {%- assign has_badge = false -%}
        {%- for block in section.blocks -%}{%- if block.type == 'trust_badge' -%}{%- assign has_badge = true -%}{%- endif -%}{%- endfor -%}
        {%- unless has_badge -%}
          <div class="vg-badge"><div class="vg-badge__dot"></div>{% if is_fr %}Certifi&eacute; CE{% else %}CE Certified{% endif %}</div>
          <div class="vg-badge"><div class="vg-badge__dot"></div>{% if is_fr %}Conforme ROHS{% else %}ROHS Compliant{% endif %}</div>
          <div class="vg-badge"><div class="vg-badge__dot"></div>{% if is_fr %}Garantie 3 ans{% else %}3-Year Warranty{% endif %}</div>
          <div class="vg-badge"><div class="vg-badge__dot"></div>{% if is_fr %}Retours gratuits{% else %}Free Returns{% endif %}</div>
        {%- endunless -%}
      </div>
    </div>
  </section>

  <section class="vg-section">
    <div class="vg-inner">
      <div class="vg-label">{% if is_fr %}Con&ccedil;u en deux &eacute;ditions premium{% else %}{{ section.settings.products_label | default: 'Engineered in Two Elite Editions' }}{% endif %}</div>
      <h2 class="vg-title">{% if is_fr %}La technologie bien-&ecirc;tre la plus avanc&eacute;e{% else %}{{ section.settings.products_title | default: 'The Most Advanced Wellness Technology' }}{% endif %}</h2>
      <div class="vg-products-grid">
        <div class="vg-product-card">
          <div class="vg-product-img">
            {%- if section.settings.prod1_image -%}
              <img src="{{ section.settings.prod1_image | img_url: '800x600', crop: 'center' }}" alt="{{ section.settings.prod1_name }}" />
            {%- else -%}
              <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="rgba(200,16,46,0.4)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
            {%- endif -%}
            <span class="vg-product-tag">{% if is_fr %}7 spectres{% else %}{{ section.settings.prod1_badge | default: '9th Gen' }}{% endif %}</span>
          </div>
          <div class="vg-product-body">
            <div class="vg-product-series">{% if is_fr %}La r&eacute;f&eacute;rence de bureau{% else %}{{ section.settings.prod1_series_label | default: 'The Proven Leader' }}{% endif %}</div>
            <h3>{{ section.settings.prod1_name | default: 'Antared Original' }}</h3>
            <p>{% if is_fr %}La luminoth&eacute;rapie rouge de bureau, pr&eacute;cise et &eacute;l&eacute;gante. Antared DESK combine 7 longueurs d'onde ind&eacute;pendantes avec contr&ocirc;le tactile et application pour adapter chaque s&eacute;ance &agrave; la r&eacute;cup&eacute;ration, &agrave; la concentration ou au sommeil.{% else %}{{ section.settings.prod1_desc | default: 'Advanced multi-spectrum output with superior power density. Digital control system. Delivers clinical-grade results with simplified daily operation.' }}{% endif %}</p>
            <ul class="vg-features">
              <li>{% if is_fr %}Spectre complet &agrave; 7 longueurs d'onde{% else %}{{ section.settings.prod1_feat1 | default: '7-Wave full-spectrum output' }}{% endif %}</li>
              <li>{% if is_fr %}Irradiance haute puissance{% else %}{{ section.settings.prod1_feat2 | default: 'Ultra-high irradiance power' }}{% endif %}</li>
              <li>{% if is_fr %}Contr&ocirc;le tactile{% else %}{{ section.settings.prod1_feat3 | default: 'Touchscreen control' }}{% endif %}</li>
              <li>{% if is_fr %}Design compact de bureau{% else %}{{ section.settings.prod1_feat4 | default: 'Modular panel design' }}{% endif %}</li>
            </ul>
            <div class="vg-product-price">
              <span class="vg-price-from">{% if is_fr %}&Agrave; partir de{% else %}From{% endif %}</span>
              <span class="vg-price-amount">{{ section.settings.prod1_price | default: '299 EUR' }}</span>
            </div>
            <a href="{{ section.settings.prod1_url | default: '/collections/all' }}" class="vg-card-btn vg-card-btn--border">{% if is_fr %}Acheter{% else %}Shop Now{% endif %}</a>
          </div>
        </div>
        <div class="vg-product-card vg-product-card--featured">
          <div class="vg-product-img">
            {%- if section.settings.prod2_image -%}
              <img src="{{ section.settings.prod2_image | img_url: '800x600', crop: 'center' }}" alt="{{ section.settings.prod2_name }}" />
            {%- else -%}
              <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="rgba(200,16,46,0.4)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
            {%- endif -%}
            <span class="vg-product-tag">{% if is_fr %}Nouveau{% else %}{{ section.settings.prod2_badge | default: 'New' }}{% endif %}</span>
          </div>
          <div class="vg-product-body">
