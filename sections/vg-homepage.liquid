        <div class="vg-stat"><div class="vg-stat__num">100+</div><div class="vg-stat__label">{% if is_fr %}Pays servis{% else %}Countries Served{% endif %}</div></div>
        <div class="vg-stat"><div class="vg-stat__num">3&ndash;5</div><div class="vg-stat__label">{% if is_fr %}Jours en UE{% else %}Day EU Delivery{% endif %}</div></div>
        <div class="vg-stat"><div class="vg-stat__num">{% if is_fr %}Gratuits{% else %}Free{% endif %}</div><div class="vg-stat__label">{% if is_fr %}Retours{% else %}Returns{% endif %}</div></div>
        <div class="vg-stat"><div class="vg-stat__num">24/7</div><div class="vg-stat__label">Support</div></div>
      </div>
    </div>
  </section>

  <section class="vg-section" style="background:linear-gradient(135deg,#0f0305,#0a0a0a);border-top:1px solid var(--vg-border);border-bottom:1px solid var(--vg-border);text-align:center;">
    <div class="vg-label">{% if is_fr %}Restez inform&eacute;{% else %}Stay in the Loop{% endif %}</div>
    <h2 class="vg-title" style="font-size:clamp(28px,4vw,44px);">{% if is_fr %}Rejoignez notre <em>liste email</em>{% else %}Join Our <em>Mailing List</em>{% endif %}</h2>
    <p style="color:var(--vg-text-muted);font-size:15px;margin-top:10px;">{% if is_fr %}Offres exclusives, nouveaut&eacute;s et conseils bien-&ecirc;tre directement dans votre bo&icirc;te mail.{% else %}Exclusive offers, new launches, and wellness tips straight to your inbox.{% endif %}</p>
    {%- form 'customer', class: 'vg-email-wrap' -%}
      <input type="hidden" name="contact[tags]" value="newsletter" />
      <input type="email" name="contact[email]" class="vg-email-input" placeholder="{% if is_fr %}votre@email.com{% else %}your@email.com{% endif %}" required />
      <button type="submit" class="vg-btn">{% if is_fr %}S'inscrire{% else %}Sign Up{% endif %}</button>
    {%- endform -%}
  </section>

</div>

<script>
  function vgSetTab(el) {
    el.closest('.vg-tabs').querySelectorAll('.vg-tab').forEach(function(t){ t.classList.remove('active'); });
    el.classList.add('active');
  }
</script>

