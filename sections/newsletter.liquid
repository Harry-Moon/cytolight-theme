<section class="section">
  <div class="container">
    <div class="newsletter">
      <span class="eyebrow" style="color: rgba(255,255,255,.7)">{% if request.locale.iso_code contains 'fr' %}Restez inform&eacute;{% else %}{{ section.settings.eyebrow | default: 'Stay in the loop' }}{% endif %}</span>
      <h2>{% if request.locale.iso_code contains 'fr' %}Sommeil, r&eacute;cup&eacute;ration et &eacute;clat, directement dans votre bo&icirc;te mail.{% else %}{{ section.settings.heading | default: 'Sleep, recovery, and beauty — in your inbox.' }}{% endif %}</h2>
      <p>{% if request.locale.iso_code contains 'fr' %}Profitez de 10% de remise sur votre premi&egrave;re commande.{% else %}{{ section.settings.subheading | default: 'Plus 10% off your first order.' }}{% endif %}</p>
      {% form 'customer', class: 'newsletter-form', id: 'NewsletterForm' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="email" name="contact[email]" placeholder="{% if request.locale.iso_code contains 'fr' %}Adresse email{% else %}Email address{% endif %}" required aria-label="Email">
        <button type="submit" class="btn">{% if request.locale.iso_code contains 'fr' %}S'inscrire{% else %}{{ section.settings.cta_label | default: 'Subscribe' }}{% endif %}</button>
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Subscribe" }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
