<section class="ln-page-pro">
  {% render 'editorial-hero',
     crumb_fr: crumb_fr, crumb_en: crumb_en,
     kicker_fr: kicker_fr, kicker_en: kicker_en,
     title_fr: titre_fr, title_en: titre_en %}

  <section class="ln-section ln-section--tight">
    <div class="ln-shell ln-shell--narrow">
      <p class="ln-copy">{% if is_fr %}{{ intro_fr }}{% else %}{{ intro_en }}{% endif %}</p>
      <p class="ln-copy"><strong>{% if is_fr %}{{ pour_qui_fr }}{% else %}{{ pour_qui_en }}{% endif %}</strong></p>
    </div>
  </section>

  <section class="ln-section ln-section--tight">
    <div class="ln-shell">
      {% render 'media-slot',
         file: media_hero_file, w: media_hero_w, h: media_hero_h,
         ratio: '16 / 9', priority: 'high',
         alt_fr: media_hero_brief_fr, alt_en: media_hero_brief_en,
         brief_fr: media_hero_brief_fr, brief_en: media_hero_brief_en %}
    </div>
  </section>

  <section class="ln-section ln-section--soft">
    <div class="ln-shell">
      <div class="ln-head ln-reveal">
        <div>
          <p class="ln-kicker">{% if is_fr %}{{ contraintes_kicker_fr }}{% else %}{{ contraintes_kicker_en }}{% endif %}</p>
          <h2 class="ln-subtitle">{% if is_fr %}{{ contraintes_titre_fr }}{% else %}{{ contraintes_titre_en }}{% endif %}</h2>
        </div>
        <div class="ln-head__aside">
          <p>{% if is_fr %}{{ contraintes_aside_fr }}{% else %}{{ contraintes_aside_en }}{% endif %}</p>
        </div>
      </div>

      <div class="ln-steps">
        {%- if is_fr -%}
          {%- assign contraintes = contraintes_fr | split: '|' -%}
        {%- else -%}
          {%- assign contraintes = contraintes_en | split: '|' -%}
        {%- endif -%}
        {%- for contrainte in contraintes -%}
          {%- assign paire = contrainte | split: '~' -%}
          <div class="ln-step">
            <h3 class="ln-step__title">{{ paire[0] }}</h3>
            <p class="ln-step__text">{{ paire[1] }}</p>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>

  <section class="ln-section">
    <div class="ln-shell">
      <div class="ln-split">
        <div class="ln-split__text ln-reveal">
          <p class="ln-kicker">{% if is_fr %}{{ install_kicker_fr }}{% else %}{{ install_kicker_en }}{% endif %}</p>
          <h2 class="ln-subtitle">{% if is_fr %}{{ install_titre_fr }}{% else %}{{ install_titre_en }}{% endif %}</h2>
          <p class="ln-copy">{% if is_fr %}{{ install_texte_fr }}{% else %}{{ install_texte_en }}{% endif %}</p>

          <div class="ln-steps ln-steps--stack">
            {%- if is_fr -%}
              {%- assign install_etapes = install_etapes_fr | split: '|' -%}
            {%- else -%}
              {%- assign install_etapes = install_etapes_en | split: '|' -%}
