            <div class="ln-bodymap__figure">
              <svg viewBox="0 0 240 460" role="img" aria-labelledby="ln-goal-bm-title ln-goal-bm-desc">
                <title id="ln-goal-bm-title">{% if is_fr %}Les six zones de r&eacute;cup&eacute;ration list&eacute;es sur cette page{% else %}The six recovery areas listed on this page{% endif %}</title>
                <desc id="ln-goal-bm-desc">{% if is_fr %}Silhouette humaine sch&eacute;matique portant six rep&egrave;res num&eacute;rot&eacute;s&nbsp;: nuque et &eacute;paules, dos et lombaires, cuisses et mollets, genou, pied et cheville, mains et poignets. Chaque rep&egrave;re correspond &agrave; une entr&eacute;e des deux listes qui encadrent la figure.{% else %}Schematic human figure carrying six numbered markers: neck and shoulders, back and lower back, quads and calves, knee, foot and ankle, hands and wrists. Each marker matches an entry in the two lists framing the figure.{% endif %}</desc>
                <defs>
                  <radialGradient id="ln-goal-bm-glow" cx="50%" cy="42%" r="55%">
                    <stop offset="0%" stop-color="#d20d2f" stop-opacity=".34"/>
                    <stop offset="60%" stop-color="#d20d2f" stop-opacity=".08"/>
                    <stop offset="100%" stop-color="#d20d2f" stop-opacity="0"/>
                  </radialGradient>
                </defs>
                <rect x="0" y="0" width="240" height="460" fill="url(#ln-goal-bm-glow)"/>
                <g class="ln-bodymap__body" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="120" cy="44" r="25"/>
                  <path d="M120 69v18"/>
                  <path d="M86 96q34-14 68 0l7 78q-41 12-82 0z"/>
                  <path d="M86 96 61 116l-14 84 13 5 17-74"/>
                  <path d="M154 96l25 20 14 84-13 5-17-74"/>
                  <path d="M92 174l-4 96 6 84h17l4-84"/>
                  <path d="M148 174l4 96-6 84h-17l-4-84"/>
