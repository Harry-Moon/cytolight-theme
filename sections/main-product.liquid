  .cl-spectrum-science__chip{border-radius:10px;padding:6px 2px;}
  .cl-spectrum-science__dot{width:10px;height:10px;margin-bottom:5px;}
  .cl-spectrum-science__nm{font-size:10px;}
  .cl-spectrum-science__tag{font-size:8px;}
