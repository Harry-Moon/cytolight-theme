<style>
.cl-page{width:100%;background:#fff;}
.cl-launch-hero{position:relative;min-height:680px;background:#080808;color:#fff;overflow:hidden;display:flex;align-items:stretch;}
.cl-launch-hero__media{position:absolute;inset:0;opacity:.66;}
.cl-launch-hero__media::after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,rgba(0,0,0,.88) 0%,rgba(0,0,0,.48) 42%,rgba(0,0,0,.15) 100%);}
.cl-launch-hero__media img,.cl-launch-hero__media svg,.cl-launch-hero__media video{width:100%;height:100%;object-fit:cover;}
.cl-launch-hero__media video.cl-video-zoomout{object-fit:cover;object-position:50% 45%;background:#080808;}
.cl-launch-hero__inner{position:relative;z-index:1;max-width:1400px;width:100%;margin:0 auto;padding:96px 40px 58px;display:flex;flex-direction:column;justify-content:space-between;gap:52px;}
.cl-launch-hero__copy{max-width:720px;}
.cl-launch-hero__eyebrow{font-size:12px;font-weight:900;letter-spacing:.18em;text-transform:uppercase;color:#ff6060;margin:0 0 16px;}
.cl-launch-hero__title{font-size:clamp(48px,7vw,92px);font-weight:950;line-height:.96;letter-spacing:0;margin:0 0 18px;color:#fff;}
.cl-launch-hero__subtitle{font-size:clamp(18px,2vw,25px);line-height:1.45;color:rgba(255,255,255,.86);max-width:620px;margin:0 0 30px;}
.cl-launch-hero__ctas{display:flex;gap:12px;flex-wrap:wrap;}
.cl-launch-hero__primary,.cl-launch-hero__secondary{display:inline-flex;align-items:center;justify-content:center;border-radius:999px;padding:14px 24px;font-size:13px;font-weight:900;text-transform:uppercase;letter-spacing:.06em;transition:transform .3s ease,box-shadow .3s ease,background .3s ease,border-color .3s ease;}
.cl-launch-hero__primary{background:#fff;color:#0d0d0d;box-shadow:0 0 0 1px rgba(232,64,84,.18),0 8px 26px rgba(210,13,47,.22);}
@media (hover: hover) and (pointer: fine) { .cl-launch-hero__primary:hover{transform:translateY(-2px);box-shadow:0 0 0 1px rgba(232,64,84,.4),0 14px 36px rgba(210,13,47,.38),0 0 44px rgba(210,13,47,.28);} }
.cl-launch-hero__secondary{background:rgba(255,255,255,.12);color:#fff;border:1px solid rgba(255,255,255,.25);box-shadow:0 0 0 1px rgba(232,64,84,.1) inset;}
@media (hover: hover) and (pointer: fine) { .cl-launch-hero__secondary:hover{border-color:rgba(232,64,84,.65);background:rgba(232,64,84,.14);transform:translateY(-2px);box-shadow:0 0 0 1px rgba(232,64,84,.22) inset,0 0 34px rgba(210,13,47,.26);} }
.cl-launch-hero__stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;max-width:920px;}
.cl-launch-stat{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.16);border-radius:16px;padding:18px;backdrop-filter:blur(12px);}
.cl-launch-stat strong{display:block;font-size:30px;font-weight:950;letter-spacing:0;color:#fff;line-height:1;}
.cl-launch-stat span{display:block;margin-top:8px;font-size:12px;font-weight:700;line-height:1.35;color:rgba(255,255,255,.72);}
.cl-launch-hero__stats--glow .cl-launch-stat{position:relative;border-color:rgba(232,64,84,.32);box-shadow:0 0 0 1px rgba(232,64,84,.06) inset,0 10px 34px rgba(210,13,47,.16),0 0 46px rgba(210,13,47,.09);transition:box-shadow .5s ease,border-color .5s ease,transform .35s ease;}
.cl-launch-hero__stats--glow .cl-launch-stat::before{content:'';position:absolute;inset:0;border-radius:inherit;background:radial-gradient(120% 100% at 50% -10%,rgba(232,64,84,.2),transparent 62%);opacity:.7;pointer-events:none;animation:cl-stat-glow-breathe 6s ease-in-out infinite;}
.cl-launch-hero__stats--glow .cl-launch-stat strong{position:relative;text-shadow:0 0 22px rgba(232,64,84,.45);}
.cl-launch-hero__stats--glow .cl-launch-stat span{position:relative;}
@media (hover: hover) and (pointer: fine) { .cl-launch-hero__stats--glow .cl-launch-stat:hover{border-color:rgba(232,64,84,.6);box-shadow:0 0 0 1px rgba(232,64,84,.14) inset,0 16px 46px rgba(210,13,47,.26),0 0 64px rgba(210,13,47,.16);transform:translateY(-3px);} }
@keyframes cl-stat-glow-breathe{0%,100%{opacity:.5;}50%{opacity:1;}}
@media (prefers-reduced-motion:reduce){.cl-launch-hero__stats--glow .cl-launch-stat::before{animation:none;opacity:.7;}}
.cl-feature-showcase{background:#f6f6f6;padding:28px 40px 72px;}
.cl-persona-section{padding:64px 40px;background:#fff;border-top:1px solid #f0f0f0;}
.cl-persona-inner{max-width:1400px;margin:0 auto;}
.cl-persona-header{text-align:center;margin-bottom:36px;}
.cl-persona-eyebrow{font-size:11px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:#d20d2f;margin:0 0 12px;}
.cl-persona-title{font-size:clamp(24px,3.2vw,34px);font-weight:900;color:#0d0d0d;margin:0 auto;max-width:760px;letter-spacing:-.02em;line-height:1.15;}
.cl-persona-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px;}
.cl-persona-card{background:#fafafa;border:1px solid #eee;border-radius:16px;padding:22px 20px;transition:transform .2s,box-shadow .2s,border-color .2s,background .2s;}
@media (hover: hover) and (pointer: fine) { .cl-persona-card:hover{transform:translateY(-3px);box-shadow:0 16px 40px rgba(0,0,0,.08);border-color:#e2c9c9;background:#fff;} }
.cl-persona-card__kicker{display:block;font-size:10px;font-weight:900;letter-spacing:.12em;text-transform:uppercase;color:#d20d2f;margin:0 0 10px;}
.cl-persona-card__title{font-size:15px;font-weight:900;color:#0d0d0d;margin:0 0 6px;letter-spacing:-.01em;line-height:1.25;}
.cl-persona-card__body{font-size:12.5px;line-height:1.55;color:#666;margin:0;}
.cl-persona-card--senior{background:linear-gradient(180deg,#fff5f5,#fdf8f8);border-color:#f0dede;}
@media(max-width:1100px){.cl-persona-grid{grid-template-columns:repeat(3,minmax(0,1fr));}}
@media(max-width:700px){.cl-persona-grid{grid-template-columns:repeat(2,minmax(0,1fr));}}
@media(max-width:520px){.cl-persona-section{padding:44px 18px;}.cl-persona-grid{grid-template-columns:minmax(0,1fr);}}
.cl-feature-showcase__inner{max-width:1400px;margin:0 auto;display:grid;grid-template-columns:1.2fr 1fr 1fr;gap:14px;}
.cl-feature-tile{position:relative;min-height:260px;border-radius:18px;overflow:hidden;background:#111;color:#fff;padding:26px;display:flex;flex-direction:column;justify-content:flex-end;}
.cl-feature-tile--large{grid-row:span 2;min-height:540px;}
.cl-feature-tile__bg{position:absolute;inset:0;opacity:.5;background:radial-gradient(circle at 70% 20%,rgba(210,13,47,.65),transparent 34%),linear-gradient(135deg,#171717,#050505);}
.cl-feature-tile--light{background:#fff;color:#0d0d0d;border:1px solid #e8e8e8;}
.cl-feature-tile--light .cl-feature-tile__bg{opacity:1;background:linear-gradient(135deg,#fff,#f3f3f3);}
.cl-feature-tile--cap-head-bg .cl-feature-tile__bg,.cl-feature-tile--photo-light .cl-feature-tile__bg{background-size:cover;background-position:center 38%;}
.cl-feature-tile--cap-head-bg .cl-feature-tile__bg::after,.cl-feature-tile--photo-light .cl-feature-tile__bg::after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,rgba(255,255,255,.04) 0%,rgba(255,255,255,.14) 42%,rgba(255,255,255,.94) 100%);}
.cl-feature-tile--cap-head-bg .cl-feature-tile__content,.cl-feature-tile--photo-light .cl-feature-tile__content{max-width:92%;}
.cl-feature-tile--image-bg .cl-feature-tile__bg{opacity:1;background-size:cover;background-position:center;}
.cl-feature-tile--image-bg .cl-feature-tile__bg::after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.08) 0%,rgba(0,0,0,.22) 38%,rgba(0,0,0,.88) 100%),linear-gradient(90deg,rgba(0,0,0,.72) 0%,rgba(0,0,0,.28) 52%,rgba(0,0,0,.04) 100%);}
.cl-feature-tile--scalp-bg .cl-feature-tile__bg,.cl-feature-tile--photo-dark .cl-feature-tile__bg{background-position:center;}
.cl-feature-tile--scalp-bg .cl-feature-tile__bg::after,.cl-feature-tile--photo-dark .cl-feature-tile__bg::after{background:linear-gradient(180deg,rgba(0,0,0,.06) 0%,rgba(0,0,0,.28) 42%,rgba(0,0,0,.9) 100%),radial-gradient(circle at 18% 8%,rgba(210,16,46,.32),transparent 40%);}
.cl-feature-tile--infographic{background:#020202;}
.cl-feature-tile--infographic .cl-feature-tile__bg{opacity:1;background-size:contain;background-position:center 34%;background-repeat:no-repeat;background-color:#020202;}
.cl-feature-tile--infographic .cl-feature-tile__bg::after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.05) 0%,rgba(0,0,0,.04) 44%,rgba(0,0,0,.86) 100%);}
.cl-feature-tile__content{position:relative;z-index:1;}
.cl-feature-tile__kicker{font-size:11px;font-weight:900;text-transform:uppercase;letter-spacing:.12em;color:#d20d2f;margin:0 0 10px;}
.cl-feature-tile:not(.cl-feature-tile--light) .cl-feature-tile__kicker{color:#ff7777;}
.cl-feature-tile__title{font-size:clamp(24px,3vw,42px);font-weight:950;line-height:1.02;letter-spacing:0;margin:0 0 10px;}
.cl-feature-tile__body{font-size:14px;line-height:1.65;color:rgba(255,255,255,.72);max-width:520px;margin:0;}
.cl-feature-tile--light .cl-feature-tile__body{color:#666;}
.cl-foot-intro,.cl-mask-intro{max-width:1400px;margin:0 auto;padding:56px 40px 74px;display:grid;grid-template-columns:minmax(0,.92fr) minmax(0,1fr);gap:36px;align-items:center;background:#fff;}
.cl-foot-intro__media,.cl-mask-intro__media{min-height:430px;border-radius:24px;overflow:hidden;background:#111;box-shadow:0 28px 70px rgba(0,0,0,.14);}
.cl-foot-intro__media img,.cl-mask-intro__media img{display:block;width:100%;height:100%;min-height:430px;object-fit:cover;object-position:center;}
.cl-mask-intro__media img{object-position:15% center;}
.cl-foot-intro__copy,.cl-mask-intro__copy{padding:24px 10px 24px 24px;}
.cl-foot-intro__copy h2,.cl-mask-intro__copy h2{font-size:clamp(40px,5vw,74px);font-weight:950;letter-spacing:0;line-height:.96;margin:0 0 18px;color:#0d0d0d;}
.cl-foot-intro__copy p,.cl-mask-intro__copy p{font-size:18px;line-height:1.65;color:#5c5c5c;margin:0;max-width:620px;}
.cl-foot-intro__chips,.cl-mask-intro__chips{display:flex;flex-wrap:wrap;gap:10px;margin-top:26px;}
.cl-foot-intro__chips span,.cl-mask-intro__chips span{border:1px solid rgba(0,0,0,.12);border-radius:999px;padding:9px 13px;font-size:12px;font-weight:850;color:#1b1b1b;background:#fff;}
.cl-mask-uses{max-width:1400px;margin:0 auto;padding:56px 40px;border-top:1px solid #f0f0f0;}
.cl-mask-uses__header{text-align:center;margin-bottom:36px;}
.cl-mask-uses__eyebrow{font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#d20d2f;margin:0 0 10px;}
.cl-mask-uses__title{font-size:32px;font-weight:900;color:#0d0d0d;margin:0 0 10px;letter-spacing:-.02em;}
.cl-mask-uses__sub{font-size:15px;color:#888;margin:0 auto;max-width:680px;line-height:1.6;}
.cl-mask-uses__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;}
.cl-mask-use{position:relative;border-radius:20px;overflow:hidden;min-height:300px;display:flex;align-items:flex-end;background:#111;}
.cl-mask-use__bg{position:absolute;inset:0;background-size:cover;background-position:center;transform:scale(1.02);transition:transform .4s ease;}
@media (hover: hover) and (pointer: fine) { .cl-mask-use:hover .cl-mask-use__bg{transform:scale(1.06);} }
.cl-mask-use__veil{position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,0) 34%,rgba(0,0,0,.78) 100%);}
.cl-mask-use__content{position:relative;padding:22px;color:#fff;}
.cl-mask-use__num{display:block;font-size:11px;font-weight:800;letter-spacing:.14em;color:#ff6060;margin-bottom:8px;}
.cl-mask-use__title{font-size:20px;font-weight:900;margin:0 0 6px;letter-spacing:-.01em;}
.cl-mask-use__body{font-size:13px;line-height:1.6;margin:0;color:rgba(255,255,255,.82);}
.cl-product-wrap{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:0;max-width:1400px;margin:0 auto;padding:48px 40px;align-items:start;}
/* min-width:0 : sans lui, la piste 1fr prend pour minimum le min-content de
   la colonne, et la bande de vignettes (huit vignettes de 74px, soit 662px)
   l'impose a toute la grille. La page produit se posait alors sur 678px de
   large dans un viewport de 375 : tout defilait lateralement. Le
   overflow-x:auto de .cl-thumbstrip ne suffit pas a couper cette remontee. */
.cl-col-left{position:sticky;top:calc(var(--header-h, 0px) + 20px);padding-right:40px;min-width:0;}
.cl-gallery{width:100%;border-radius:16px;overflow:hidden;background:#f4f4f4;aspect-ratio:1/1;position:relative;}
.cl-media-slot{position:absolute;inset:0;display:none;}
.cl-media-slot.is-active{display:flex;align-items:center;justify-content:center;}
.cl-media-slot img{width:100%;height:100%;object-fit:cover;display:block;}
.cl-media-slot video{width:100%;height:100%;object-fit:contain;background:#000;}
.cl-media-slot iframe{width:100%;height:100%;border:none;}
.cl-media-slot model-viewer{width:100%;height:100%;}
.cl-media-slot .placeholder-svg{width:100%;height:100%;}
.cl-thumbstrip{display:flex;gap:10px;margin-top:14px;overflow-x:auto;padding-bottom:6px;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;}
.cl-thumbstrip::-webkit-scrollbar{height:4px;}
.cl-thumbstrip::-webkit-scrollbar-track{background:#f0f0f0;border-radius:2px;}
.cl-thumbstrip::-webkit-scrollbar-thumb{background:#ccc;border-radius:2px;}
.cl-thumbitem{flex:0 0 90px;height:90px;border-radius:10px;overflow:hidden;border:2px solid #e8e8e8;cursor:pointer;background:#f0f0f0;scroll-snap-align:start;transition:border-color .2s,transform .15s,box-shadow .2s;position:relative;}
@media (hover: hover) and (pointer: fine) { .cl-thumbitem:hover{transform:translateY(-2px);box-shadow:0 4px 12px rgba(0,0,0,.1);border-color:#ccc;} }
.cl-thumbitem.is-active{border-color:#d20d2f;box-shadow:0 0 0 1px #d20d2f;}
.cl-thumbitem img{width:100%;height:100%;object-fit:cover;display:block;}
.cl-thumbitem__play{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,.35);color:#fff;font-size:22px;}
.cl-wave-bar{background:#0d0d0d;border-radius:14px;padding:18px 20px;margin-top:20px;}
.cl-wave-bar__title{font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#aaa;margin-bottom:14px;}
.cl-wave-dots{display:flex;align-items:flex-end;gap:8px;}
.cl-wave-dot{display:flex;flex-direction:column;align-items:center;gap:6px;flex:1;}
.cl-wave-dot__circle{width:30px;height:30px;border-radius:50%;flex-shrink:0;}
.cl-wave-dot__nm{font-size:10px;font-weight:700;color:#fff;}
.cl-wave-dot__label{font-size:9px;color:#888;text-align:center;line-height:1.2;}
.cl-inbox{background:#fafafa;border:1px solid #efefef;border-radius:14px;padding:18px 20px;margin-top:16px;}
.cl-inbox__title{font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#999;margin-bottom:12px;}
.cl-inbox__list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:8px;}
.cl-inbox__item{display:flex;align-items:center;gap:10px;font-size:13px;color:#333;}
.cl-inbox__item svg{width:16px;height:16px;color:#d20d2f;flex-shrink:0;}
.cl-clinical{display:flex;align-items:center;gap:14px;background:linear-gradient(135deg,#fff5f5,#fff0f0);border:1px solid #fdd;border-radius:14px;padding:16px 18px;margin-top:16px;}
.cl-clinical__icon{width:40px;height:40px;background:#d20d2f;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.cl-clinical__icon svg{width:20px;height:20px;color:#fff;}
.cl-clinical__heading{font-size:12px;font-weight:800;color:#0d0d0d;margin:0 0 2px;}
.cl-clinical__sub{font-size:11px;color:#888;margin:0;line-height:1.4;}
.cl-certs{display:flex;gap:8px;margin-top:16px;}
.cl-cert{display:flex;flex-direction:column;align-items:center;gap:5px;background:#f8f8f8;border-radius:10px;padding:12px 8px;flex:1;text-align:center;}
.cl-cert svg{width:26px;height:26px;}
.cl-cert span{font-size:9px;font-weight:700;color:#555;line-height:1.3;text-transform:uppercase;letter-spacing:.04em;}
.cl-col-right{padding-left:8px;min-width:0;}
.cl-eyebrow{font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#d20d2f;margin:0 0 8px;}
.cl-title{font-size:36px;font-weight:900;line-height:1.1;color:#0d0d0d;margin:0 0 12px;letter-spacing:-.02em;}
.cl-rating-row{display:flex;align-items:center;gap:8px;margin-bottom:16px;flex-wrap:wrap;}
.cl-stars{color:#f5a623;font-size:17px;letter-spacing:1px;}
.cl-rating-num{font-size:14px;font-weight:800;color:#0d0d0d;}
.cl-rating-count{font-size:13px;color:#888;}
.cl-rating-sep{color:#ddd;}
.cl-rating-count a{color:inherit;text-decoration:underline;text-underline-offset:2px;}
.cl-price-row{display:flex;align-items:baseline;gap:10px;margin-bottom:6px;}
.cl-price{font-size:34px;font-weight:400;color:#0d0d0d;letter-spacing:-.02em;}
.cl-compare{font-size:20px;color:#bbb;text-decoration:line-through;}
.cl-save-badge{background:#d20d2f;color:#fff;font-size:11px;font-weight:800;border-radius:5px;padding:3px 9px;}
.cl-price-note{font-size:12px;color:#aaa;margin-bottom:20px;}
.cl-trust-row{display:flex;gap:8px;margin-bottom:22px;flex-wrap:wrap;}
.cl-pill{display:flex;align-items:center;gap:6px;background:#f0f9f0;border:1px solid #c0e0c0;border-radius:20px;padding:7px 13px;font-size:12px;font-weight:700;color:#1e6e1e;white-space:nowrap;}
.cl-pill svg{width:13px;height:13px;flex-shrink:0;}
.cl-proof-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin:0 0 22px;}
.cl-proof-card{background:#fafafa;border:1px solid #eee;border-radius:12px;padding:14px 12px;}
.cl-proof-card__kicker{display:block;font-size:10px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:#d20d2f;margin-bottom:4px;}
.cl-proof-card__text{display:block;font-size:12px;font-weight:700;line-height:1.35;color:#1a1a1a;}
.cl-tabs{margin-bottom:24px;background:#fff;border:1px solid #eee;border-radius:18px;padding:18px;box-shadow:0 16px 44px rgba(0,0,0,.05);}
.cl-tabs__nav{display:flex;border-bottom:2px solid #eee;}
.cl-tab-btn{background:none;border:none;border-bottom:2px solid transparent;margin-bottom:-2px;padding:10px 22px;font-size:14px;font-weight:700;color:#aaa;cursor:pointer;transition:color .2s,border-color .2s;}
.cl-tab-btn.is-active{color:#d20d2f;border-bottom-color:#d20d2f;}
.cl-tab-panel{display:none;padding:22px 0 4px;font-size:15px;line-height:1.85;color:#4f4f4f;}
.cl-tab-panel.is-active{display:block;}
.cl-tab-panel p{margin:0 0 18px;max-width:68ch;}
.cl-tab-panel h2,.cl-tab-panel h3,.cl-tab-panel h4{font-family:inherit;font-weight:900;letter-spacing:0;color:#0d0d0d;margin:30px 0 12px;line-height:1.15;}
.cl-tab-panel h2{font-size:26px;}
.cl-tab-panel h3{font-size:20px;}
.cl-tab-panel h4{font-size:16px;}
.cl-tab-panel ul,.cl-tab-panel ol{margin:16px 0 22px;padding:0;display:grid;gap:10px;max-width:72ch;list-style:none;}
.cl-tab-panel li{position:relative;margin:0;padding-left:24px;}
.cl-tab-panel li::before{content:'';position:absolute;left:0;top:.78em;width:7px;height:7px;border-radius:50%;background:#d20d2f;}
.cl-tab-panel strong{color:#0d0d0d;}
.cl-tab-panel table{width:100%;border-collapse:separate;border-spacing:0;margin:22px 0 28px;border:1px solid #e8e8e8;border-radius:16px;overflow:hidden;font-size:13px;line-height:1.55;}
.cl-tab-panel th{background:#0d0d0d;color:#fff;text-align:left;padding:14px 16px;font-weight:800;}
.cl-tab-panel td{padding:14px 16px;border-top:1px solid #eee;color:#444;vertical-align:top;}
.cl-tab-panel tr:nth-child(even) td{background:#fafafa;}
.cl-description-luxury{background:linear-gradient(180deg,#fff,#fbfbfb);border-radius:14px;}
.cl-description-luxury>p:first-child{font-size:16px;line-height:1.9;color:#333;background:#fafafa;border:1px solid #eee;border-radius:14px;padding:20px;max-width:none;}
.cl-description-luxury h2,.cl-description-luxury h3{padding-top:4px;}
.cl-divider{height:1px;background:#f0f0f0;margin:0 0 22px;}
.cl-section-label{font-size:11px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:#999;margin-bottom:10px;}
.cl-buy-panel{border:1.5px solid #eee;border-radius:18px;padding:18px;background:#fff;box-shadow:0 18px 48px rgba(0,0,0,.07);margin-bottom:12px;}
.cl-urgency{display:flex;align-items:center;gap:10px;background:#fff7f3;border:1px solid #ffd9c7;border-radius:12px;padding:11px 12px;margin-bottom:16px;color:#7a2f11;font-size:12px;font-weight:700;line-height:1.35;}
.cl-urgency svg{width:18px;height:18px;flex-shrink:0;color:#d20d2f;}
.cl-bundles{display:flex;gap:10px;margin-bottom:22px;}
.cl-bundle{flex:1;border:2px solid #e8e8e8;border-radius:12px;padding:14px 10px;text-align:center;cursor:pointer;transition:border-color .2s,background .2s,transform .15s;background:#fff;position:relative;}
@media (hover: hover) and (pointer: fine) { .cl-bundle:hover{transform:translateY(-1px);} }
.cl-bundle.is-selected{border-color:#d20d2f;background:#fff8f8;}
.cl-bundle__badge{position:absolute;top:-9px;left:50%;transform:translateX(-50%);background:#d20d2f;color:#fff;font-size:9px;font-weight:800;border-radius:20px;padding:2px 8px;white-space:nowrap;}
.cl-bundle__row{display:flex;align-items:baseline;gap:5px;justify-content:center;}
.cl-bundle__num{font-size:22px;font-weight:900;color:#0d0d0d;}
.cl-bundle__unit{font-size:11px;color:#777;font-weight:600;line-height:1.4;}
.cl-bundle__save{font-size:11px;font-weight:800;color:#d20d2f;display:block;margin-top:5px;min-height:16px;}
.cl-atc{display:flex;align-items:center;justify-content:center;gap:10px;width:100%;padding:19px;background:#d20d2f;color:#fff;font-size:16px;font-weight:900;border:none;border-radius:14px;cursor:pointer;letter-spacing:.02em;transition:background .2s,color .2s,box-shadow .2s,transform .18s,opacity .15s;margin-bottom:10px;box-shadow:var(--cta-shadow,0 14px 26px -10px rgba(210,13,47,.62));}
.cl-atc__price{font-weight:400;}
/* Enfoncement au survol, comme tous les CTA du site : le bouton descend et
       perd son ombre au lieu de se soulever. Voir le bloc CTA de theme.css.
       Reserve au pointeur qui sait reellement survoler : sur tactile, un tap
       ne doit pas laisser le bouton "colle" dans cet etat jusqu'au tap suivant. */
    @media (hover: hover) and (pointer: fine) {
      .cl-atc:hover{background:#d20d2f;color:#fff;box-shadow:none;}
    }
    @media (prefers-reduced-motion: no-preference) and (hover: hover) and (pointer: fine) {.cl-atc:hover{transform:translateY(var(--cta-press,3px));}}
    .cl-atc:active{opacity:.5;}
.cl-atc:disabled{background:#ccc;cursor:not-allowed;box-shadow:none;transform:none;}
.cl-atc svg{width:20px;height:20px;flex-shrink:0;}
.cl-atc--top{margin:4px 0 20px;}
.cl-payment-row{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-top:4px;}
.cl-payment-note{background:#fafafa;border:1px solid #eee;border-radius:10px;padding:10px 8px;text-align:center;font-size:11px;font-weight:700;color:#444;line-height:1.3;}
.cl-guarantee{display:flex;align-items:center;justify-content:center;gap:8px;font-size:12px;color:#888;margin-bottom:24px;padding:10px;background:#fafafa;border-radius:10px;}
.cl-guarantee svg{width:16px;height:16px;color:#2d8c2d;flex-shrink:0;}
.cl-benefits{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;padding:20px;background:#fafafa;border-radius:14px;margin-bottom:24px;}
.cl-benefit{display:flex;flex-direction:column;align-items:center;gap:8px;text-align:center;}
.cl-benefit__icon{width:52px;height:52px;background:linear-gradient(135deg,#fff5f5,#ffe8e8);border-radius:50%;display:flex;align-items:center;justify-content:center;}
.cl-benefit__icon svg{width:24px;height:24px;color:#d20d2f;}
.cl-benefit__label{font-size:12px;font-weight:800;color:#0d0d0d;line-height:1.3;}
.cl-benefit__sub{font-size:11px;color:#aaa;margin-top:1px;}
.cl-notice-section{background:linear-gradient(180deg,#fdf6f6 0%,#faf9f7 100%);border-radius:32px;max-width:1400px;margin:0 auto 48px;padding:56px 48px 64px;}
.cl-notice-head{text-align:center;max-width:640px;margin:0 auto 40px;}
.cl-notice-head .cl-eyebrow{text-align:center;}
.cl-notice-head h2{margin:0;font-size:clamp(28px,3.4vw,42px);font-weight:900;letter-spacing:-.01em;color:#0d0d0d;line-height:1.1;font-family:inherit;}
.cl-notice-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin:0 0 56px;}
.cl-notice-card{display:flex;align-items:flex-start;gap:16px;background:#fff;border:1px solid #f0e9e9;border-radius:20px;padding:26px 28px;box-shadow:0 14px 34px rgba(210,13,47,.05);transition:transform .25s ease,box-shadow .25s ease;}
@media (hover: hover) and (pointer: fine) { .cl-notice-card:hover{transform:translateY(-3px);box-shadow:0 20px 44px rgba(210,13,47,.1);} }
.cl-notice-card__icon{flex-shrink:0;width:44px;height:44px;border-radius:50%;background:linear-gradient(135deg,#e8304a,#d20d2f);display:flex;align-items:center;justify-content:center;color:#fff;box-shadow:0 8px 18px rgba(210,13,47,.28);}
.cl-notice-card__icon svg{width:20px;height:20px;stroke-width:3;}
.cl-notice-card h4{margin:0 0 6px;font-size:18px;font-weight:800;color:#0d0d0d;line-height:1.3;font-family:inherit;}
.cl-notice-card p{margin:0;font-size:14.5px;line-height:1.6;color:#666;}
.cl-how-flow__title{text-align:center;margin:0 0 32px;}
.cl-how-flow__title .cl-eyebrow{text-align:center;}
.cl-how-flow__title h3{margin:0;font-size:clamp(22px,2.4vw,28px);font-weight:900;color:#0d0d0d;font-family:inherit;}
.cl-how-flow__steps{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0;position:relative;}
.cl-how-flow__steps::before{content:'';position:absolute;top:28px;left:calc(100%/6);right:calc(100%/6);height:2px;background:repeating-linear-gradient(90deg,#e8b9c0 0,#e8b9c0 8px,transparent 8px,transparent 16px);z-index:0;}
.cl-how-flow__steps li{display:flex;flex-direction:column;align-items:center;text-align:center;gap:14px;padding:0 18px;position:relative;z-index:1;}
.cl-how-flow__num{flex-shrink:0;width:56px;height:56px;border-radius:50%;background:linear-gradient(135deg,#1a1a1a,#000);color:#fff;font-size:20px;font-weight:800;display:flex;align-items:center;justify-content:center;box-shadow:0 10px 24px rgba(0,0,0,.22);position:relative;}
.cl-how-flow__steps h4{margin:0 0 6px;font-size:17px;font-weight:800;color:#0d0d0d;line-height:1.3;font-family:inherit;}
.cl-how-flow__steps p{margin:0;font-size:14px;line-height:1.6;color:#666;max-width:240px;}

/* ===== Notice section: catchy reveal + red-light halo ===== */
.cl-how-flow__num::before,.cl-how-flow__num::after{content:'';position:absolute;inset:-6px;border-radius:50%;border:2px solid rgba(210,13,47,.55);opacity:0;pointer-events:none;}
.cl-how-flow__steps li:nth-child(1) .cl-how-flow__num::before{animation:cl-halo-pulse 2.8s ease-out 1.4s infinite;}
.cl-how-flow__steps li:nth-child(2) .cl-how-flow__num::before{animation:cl-halo-pulse 2.8s ease-out 1.9s infinite;}
.cl-how-flow__steps li:nth-child(3) .cl-how-flow__num::before{animation:cl-halo-pulse 2.8s ease-out 2.4s infinite;}
.cl-how-flow__steps li:nth-child(1) .cl-how-flow__num::after{animation:cl-halo-pulse 2.8s ease-out 2.8s infinite;}
.cl-how-flow__steps li:nth-child(2) .cl-how-flow__num::after{animation:cl-halo-pulse 2.8s ease-out 3.3s infinite;}
.cl-how-flow__steps li:nth-child(3) .cl-how-flow__num::after{animation:cl-halo-pulse 2.8s ease-out 3.8s infinite;}
@keyframes cl-halo-pulse{0%{opacity:.7;transform:scale(1);}100%{opacity:0;transform:scale(1.7);}}

.cl-notice-head,.cl-how-flow__title{opacity:0;transform:translateY(22px);transition:opacity .8s ease,transform .8s cubic-bezier(.16,1,.3,1);}
.cl-notice-card{opacity:0;transform:translateY(26px);transition:opacity .6s ease,transform .6s cubic-bezier(.16,1,.3,1),box-shadow .25s ease;}
.cl-how-flow__steps li{opacity:0;transform:translateY(26px);transition:opacity .6s ease,transform .6s cubic-bezier(.16,1,.3,1);}
.cl-how-flow__steps::before{transform-origin:left center;transform:scaleX(0);transition:transform 1.1s cubic-bezier(.16,1,.3,1) .9s;}

.cl-notice-section.is-visible .cl-notice-head{opacity:1;transform:translateY(0);}
.cl-notice-section.is-visible .cl-notice-card{opacity:1;transform:translateY(0);}
.cl-notice-section.is-visible .cl-notice-card:nth-child(1){transition-delay:.12s;}
.cl-notice-section.is-visible .cl-notice-card:nth-child(2){transition-delay:.2s;}
.cl-notice-section.is-visible .cl-notice-card:nth-child(3){transition-delay:.28s;}
.cl-notice-section.is-visible .cl-notice-card:nth-child(4){transition-delay:.36s;}
.cl-notice-section.is-visible .cl-how-flow__title{transition-delay:.46s;opacity:1;transform:translateY(0);}
.cl-notice-section.is-visible .cl-how-flow__steps::before{transform:scaleX(1);}
.cl-notice-section.is-visible .cl-how-flow__steps li{opacity:1;transform:translateY(0);}
.cl-notice-section.is-visible .cl-how-flow__steps li:nth-child(1){transition-delay:.62s;}
.cl-notice-section.is-visible .cl-how-flow__steps li:nth-child(2){transition-delay:.78s;}
.cl-notice-section.is-visible .cl-how-flow__steps li:nth-child(3){transition-delay:.94s;}

@media (prefers-reduced-motion: reduce){
  .cl-notice-head,.cl-how-flow__title,.cl-notice-card,.cl-how-flow__steps li{opacity:1!important;transform:none!important;transition:none!important;}
  .cl-how-flow__steps::before{transform:scaleX(1)!important;transition:none!important;}
  .cl-how-flow__num::before,.cl-how-flow__num::after{display:none!important;}
}
.cl-reviews{border:1px solid #eee;border-radius:14px;padding:18px 20px;}
.cl-reviews:not(:empty){border:1px solid #eee;border-radius:14px;padding:18px 20px;}
.cl-reviews:has(.cl-reviews__app:empty):not(:has(.cl-reviews__header)){border:0;padding:0;}
.cl-reviews__header{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;}
.cl-reviews__title{font-size:13px;font-weight:800;color:#0d0d0d;}
.cl-reviews__avg{display:flex;align-items:center;gap:6px;}
.cl-reviews__big{font-size:28px;font-weight:900;color:#0d0d0d;}
.cl-sticky-atc{position:fixed;left:50%;top:calc(var(--header-h, 0px) + 12px);transform:translate(-50%,-18px);z-index:60;width:min(760px,calc(100% - 32px));display:flex;align-items:center;justify-content:space-between;gap:16px;background:rgba(13,13,13,.96);color:#fff;border:1px solid rgba(255,255,255,.12);border-radius:18px;padding:12px 14px 12px 18px;box-shadow:0 18px 50px rgba(0,0,0,.28);backdrop-filter:blur(10px);opacity:0;pointer-events:none;transition:opacity .2s,transform .2s;}
.cl-sticky-atc.is-visible{opacity:1;pointer-events:auto;transform:translate(-50%,0);}
.cl-sticky-atc__info{min-width:0;}
.cl-sticky-atc__title{display:block;font-size:13px;font-weight:800;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:420px;}
.cl-sticky-atc__meta{display:flex;gap:8px;align-items:center;font-size:12px;color:rgba(255,255,255,.72);margin-top:2px;}
.cl-sticky-atc__button{flex:0 0 auto;background:#d20d2f;color:#fff;border:none;border-radius:12px;padding:13px 18px;font-size:13px;font-weight:900;letter-spacing:.04em;text-transform:uppercase;cursor:pointer;box-shadow:0 8px 24px rgba(210,13,47,.35);}
@media (hover: hover) and (pointer: fine) { .cl-sticky-atc__button:hover{background:#a50d25;} }
.cl-sticky-atc__button:disabled{background:#555;cursor:not-allowed;box-shadow:none;}
/* ===== STATS STRIP ===== */
.cl-stats-strip{background:#0d0d0d;padding:48px 40px;}
.cl-stats-inner{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:20px;max-width:1400px;margin:0 auto;}
.cl-stat{text-align:center;padding:16px;}
.cl-stat__num{font-size:48px;font-weight:900;color:#d20d2f;display:block;letter-spacing:-.03em;line-height:1;}
.cl-stat__label{font-size:12px;color:#888;font-weight:600;display:block;margin-top:8px;text-transform:uppercase;letter-spacing:.08em;}
.cl-stats-strip--glow{position:relative;background:radial-gradient(120% 160% at 50% 0%,#160707 0%,#0d0d0d 55%,#0a0a0a 100%);overflow:hidden;}
.cl-stats-strip--glow::before{content:'';position:absolute;inset:0;background:linear-gradient(180deg,rgba(210,13,47,.1),transparent 45%);pointer-events:none;}
.cl-stats-strip--glow .cl-stats-inner{position:relative;}
.cl-stats-strip--glow .cl-stat{position:relative;border-radius:16px;border:1px solid rgba(232,64,84,.22);background:rgba(255,255,255,.02);backdrop-filter:blur(6px);padding:26px 16px;transition:box-shadow .5s ease,border-color .5s ease,transform .35s ease;box-shadow:0 0 0 1px rgba(232,64,84,.05) inset,0 10px 30px rgba(210,13,47,.14),0 0 40px rgba(210,13,47,.08);}
.cl-stats-strip--glow .cl-stat::before{content:'';position:absolute;inset:0;border-radius:inherit;background:radial-gradient(120% 100% at 50% -10%,rgba(232,64,84,.18),transparent 62%);opacity:.65;pointer-events:none;animation:cl-stat-glow-breathe 6s ease-in-out infinite;}
.cl-stats-strip--glow .cl-stat__num{position:relative;text-shadow:0 0 26px rgba(232,64,84,.55);}
.cl-stats-strip--glow .cl-stat__label{position:relative;color:rgba(255,255,255,.68);}
@media (hover: hover) and (pointer: fine) { .cl-stats-strip--glow .cl-stat:hover{border-color:rgba(232,64,84,.55);box-shadow:0 0 0 1px rgba(232,64,84,.12) inset,0 16px 40px rgba(210,13,47,.22),0 0 56px rgba(210,13,47,.14);transform:translateY(-4px);} }
@media (prefers-reduced-motion:reduce){.cl-stats-strip--glow .cl-stat::before{animation:none;opacity:.65;}}
/* ===== EDITORIAL ===== */
.cl-editorial{padding:80px 40px;}
.cl-editorial--dark{background:#0d0d0d;position:relative;overflow:hidden;}
.cl-shader-canvas{position:absolute;inset:0;width:100%;height:100%;z-index:0;display:block;}
.cl-editorial--dark .cl-editorial__inner{position:relative;z-index:1;}
.cl-editorial--dark .cl-editorial__body{color:rgba(255,255,255,.86);font-size:17px;line-height:1.75;max-width:620px;}
.cl-editorial--dark .cl-editorial__body strong{color:#fff;}
/* wavelength overlay cards */
.cl-wl-cards{display:flex;flex-direction:column;gap:5px;}
.cl-wl-card{display:flex;align-items:center;gap:18px;padding:14px 20px;border-radius:10px;overflow:hidden;position:relative;}
.cl-wl-card__bg{position:absolute;inset:0;z-index:0;}
.cl-wl-card__nm{font-size:26px;font-weight:900;color:#fff;position:relative;z-index:1;min-width:82px;line-height:1;letter-spacing:-.03em;flex-shrink:0;}
.cl-wl-card__info{position:relative;z-index:1;display:flex;flex-direction:column;gap:3px;}
.cl-wl-card__name{font-size:13px;font-weight:800;color:#fff;line-height:1.1;}
.cl-wl-card__desc{font-size:11px;color:rgba(255,255,255,0.65);line-height:1.3;}
.cl-editorial__inner{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:72px;max-width:1400px;margin:0 auto;align-items:center;}
.cl-editorial--img-right .cl-editorial__inner{direction:rtl;}
.cl-editorial--img-right .cl-editorial__inner>*{direction:ltr;}
.cl-editorial__img-wrap{aspect-ratio:4/3;overflow:hidden;border-radius:20px;background:#f4f4f4;}
.cl-editorial__img{width:100%;height:100%;object-fit:cover;display:block;}
.cl-editorial__eyebrow{font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#d20d2f;margin:0 0 14px;}
.cl-editorial__title{font-size:34px;font-weight:900;line-height:1.1;color:#0d0d0d;margin:0 0 20px;letter-spacing:-.02em;}
.cl-editorial__body{font-size:15px;line-height:1.8;color:#555;margin:0 0 14px;}
.cl-editorial__bullets{list-style:none;padding:0;margin:20px 0 0;display:flex;flex-direction:column;gap:10px;}
.cl-editorial__bullets li{display:flex;align-items:center;gap:12px;font-size:14px;font-weight:600;color:#333;}
.cl-editorial__bullets li::before{content:'';width:8px;height:8px;background:#d20d2f;border-radius:50%;flex-shrink:0;}
/* wavelength list */
.cl-wl-list{display:flex;flex-direction:column;gap:11px;margin-top:24px;}
.cl-wl-row{display:flex;align-items:center;gap:12px;}
.cl-wl-swatch{width:14px;height:14px;border-radius:50%;flex-shrink:0;}
.cl-wl-nm{font-size:13px;font-weight:800;color:#fff;min-width:110px;}
.cl-wl-desc{font-size:12px;color:#777;}
.cl-wl-visual{display:flex;flex-direction:column;align-items:center;padding:32px 28px 20px;background:#111;border-radius:20px;}
.cl-wl-bars{display:flex;align-items:flex-end;gap:12px;height:220px;width:100%;}
.cl-wl-bar{flex:1;border-radius:6px 6px 0 0;min-height:20px;opacity:.9;}
.cl-wl-visual__label{font-size:10px;color:#444;margin-top:20px;text-align:center;letter-spacing:.08em;text-transform:uppercase;}
/* ===== WHY CHOOSE ===== */
.cl-why-section{padding:96px 40px;background:#f5f5f5;overflow:hidden;}
.cl-why-inner{max-width:1400px;margin:0 auto;}
.cl-why-header{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(320px,.85fr);gap:56px;align-items:end;margin-bottom:38px;}
.cl-why-header--desk{grid-template-columns:minmax(380px,.95fr) minmax(360px,1.05fr);gap:72px;align-items:center;margin-bottom:56px;}
.cl-why-header--cap{grid-template-columns:minmax(0,.92fr) minmax(380px,1.08fr);gap:64px;align-items:end;}
.cl-why-header__visual{grid-column:1;grid-row:1;align-self:start;position:relative;aspect-ratio:16/10;border-radius:26px;overflow:hidden;background:#111;box-shadow:0 22px 54px rgba(0,0,0,.12);}
.cl-why-header__visual::after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,0),rgba(0,0,0,.16));pointer-events:none;}
.cl-why-header__image{width:100%;height:100%;object-fit:cover;object-position:center;display:block;}
.cl-why-header--desk .cl-why-header__visual{grid-column:1;grid-row:1 / span 3;align-self:center;aspect-ratio:16/10;border-radius:24px;box-shadow:0 28px 80px rgba(0,0,0,.14);}
.cl-why-header--desk .cl-why-header__visual::after{background:linear-gradient(180deg,rgba(0,0,0,0),rgba(0,0,0,.1));}
.cl-why-header--desk .cl-why-eyebrow{grid-column:2;grid-row:1;margin:0 0 14px;}
.cl-why-header--desk .cl-why-title{grid-column:2;grid-row:2;font-size:clamp(38px,5vw,66px);line-height:1.01;font-weight:920;max-width:720px;}
.cl-why-header--desk .cl-why-sub{grid-column:2;grid-row:3;margin-top:18px;max-width:620px;}
.cl-why-header--cap .cl-why-eyebrow{grid-column:1;grid-row:2;margin-top:18px;}
.cl-why-header--cap .cl-why-sub{grid-column:1;grid-row:3;}
.cl-why-header--cap .cl-why-title{grid-column:2;grid-row:1 / span 3;align-self:start;}
.cl-why-eyebrow{font-size:11px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:#d20d2f;margin:0 0 16px;}
.cl-why-title{font-size:clamp(44px,6vw,82px);font-weight:950;color:#0d0d0d;margin:0;letter-spacing:0;line-height:.96;}
.cl-why-sub{font-size:18px;line-height:1.65;color:#555;margin:0;max-width:520px;}
.cl-why-grid{display:flex;flex-direction:column;gap:26px;padding:10px 0 0;}
.cl-why-card{position:relative;min-height:560px;border-radius:30px;padding:0;background:#111;color:#fff;overflow:hidden;display:grid;grid-template-columns:minmax(0,1fr) minmax(420px,1fr);border:1px solid rgba(255,255,255,.08);box-shadow:0 22px 60px rgba(0,0,0,.12);}
.cl-why-card:nth-child(even){background:#fff;color:#0d0d0d;border-color:#e5e5e5;}
.cl-why-card::before{content:'';position:absolute;inset:0;background:radial-gradient(circle at 80% 12%,rgba(210,13,47,.42),transparent 35%),linear-gradient(180deg,rgba(255,255,255,.08),rgba(255,255,255,0));opacity:.9;pointer-events:none;}
.cl-why-card:nth-child(even)::before{background:radial-gradient(circle at 85% 10%,rgba(210,13,47,.12),transparent 36%),linear-gradient(180deg,#fff,#f8f8f8);}
.cl-why-card__text{position:relative;z-index:1;display:flex;flex-direction:column;justify-content:center;padding:64px 56px;}
.cl-why-card:nth-child(even) .cl-why-card__text{grid-column:2;grid-row:1;}
.cl-why-card__icon{width:48px;height:48px;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.16);border-radius:50%;display:flex;align-items:center;justify-content:center;margin-bottom:22px;}
.cl-why-card:nth-child(even) .cl-why-card__icon{background:#fff;border-color:#eee;box-shadow:0 12px 28px rgba(0,0,0,.07);}
.cl-why-card__icon svg{width:22px;height:22px;color:#ff5a70;}
.cl-why-card:nth-child(even) .cl-why-card__icon svg{color:#d20d2f;}
.cl-why-card__content{min-width:0;}
.cl-why-card__label{display:block;font-size:11px;font-weight:900;text-transform:uppercase;letter-spacing:.14em;color:#ff6d7f;margin-bottom:16px;}
.cl-why-card:nth-child(even) .cl-why-card__label{color:#d20d2f;}
.cl-why-card__title{font-size:clamp(42px,5vw,76px);font-weight:950;color:inherit;margin:0 0 24px;letter-spacing:0;line-height:.96;max-width:650px;}
.cl-why-card__body{font-size:18px;color:rgba(255,255,255,.72);line-height:1.75;margin:0 0 28px;max-width:560px;}
.cl-why-card:nth-child(even) .cl-why-card__body{color:#5d5d5d;}
.cl-why-lesson{border-top:1px solid rgba(255,255,255,.16);padding-top:18px;margin-top:20px;}
.cl-why-card:nth-child(even) .cl-why-lesson{border-top-color:#e8e8e8;}
.cl-why-lesson strong{display:block;font-size:11px;font-weight:900;letter-spacing:.12em;text-transform:uppercase;color:rgba(255,255,255,.48);margin-bottom:8px;}
.cl-why-card:nth-child(even) .cl-why-lesson strong{color:#999;}
.cl-why-lesson span{display:block;font-size:13px;line-height:1.65;color:rgba(255,255,255,.72);}
.cl-why-card:nth-child(even) .cl-why-lesson span{color:#333;}
.cl-why-proof{display:flex;gap:8px;flex-wrap:wrap;margin-top:24px;}
.cl-why-proof span{display:inline-flex;align-items:center;border:1px solid rgba(255,255,255,.16);background:rgba(255,255,255,.1);border-radius:999px;padding:8px 10px;font-size:11px;font-weight:900;color:rgba(255,255,255,.76);}
.cl-why-card:nth-child(even) .cl-why-proof span{border-color:#e8e8e8;background:#fafafa;color:#555;}
.cl-why-card__media{position:relative;z-index:1;min-height:420px;margin:18px;border-radius:24px;background:linear-gradient(135deg,rgba(255,255,255,.12),rgba(255,255,255,.03));border:1px solid rgba(255,255,255,.14);display:flex;align-items:center;justify-content:center;overflow:hidden;}
.cl-why-card:nth-child(even) .cl-why-card__media{grid-column:1;grid-row:1;background:linear-gradient(135deg,#f7f7f7,#ededed);border-color:#e5e5e5;}
.cl-why-card__media::before{content:'';position:absolute;inset:0;background:radial-gradient(circle at 50% 38%,rgba(210,13,47,.32),transparent 34%);}
.cl-why-card:nth-child(even) .cl-why-card__media::before{background:radial-gradient(circle at 50% 36%,rgba(210,13,47,.16),transparent 34%);}
.cl-why-card__image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;display:block;z-index:0;}
.cl-why-card__media--photo::before{z-index:1;background:linear-gradient(180deg,rgba(8,8,8,.06),rgba(8,8,8,.28));}
.cl-why-placeholder{position:relative;z-index:1;width:min(72%,420px);aspect-ratio:4/5;border-radius:28px;background:linear-gradient(145deg,rgba(255,255,255,.22),rgba(255,255,255,.06));border:1px solid rgba(255,255,255,.2);box-shadow:0 28px 80px rgba(0,0,0,.22);display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,.72);font-size:12px;font-weight:900;letter-spacing:.12em;text-transform:uppercase;text-align:center;}
.cl-why-card:nth-child(even) .cl-why-placeholder{background:linear-gradient(145deg,#fff,#e9e9e9);border-color:#ddd;color:#999;box-shadow:0 28px 70px rgba(0,0,0,.12);}
.cl-why-card__media--science{background:linear-gradient(145deg,#050607,#15171a)!important;border-color:rgba(255,255,255,.1)!important;}
.cl-why-card__media--science::before{background:radial-gradient(circle at 50% 18%,rgba(210,13,47,.34),transparent 38%),linear-gradient(180deg,rgba(255,255,255,.04),transparent)!important;}
.cl-spectrum-science{position:relative;z-index:2;width:min(88%,540px);padding:24px;border-radius:28px;background:linear-gradient(180deg,#070809,#11151a);border:1px solid rgba(255,255,255,.14);box-shadow:0 30px 80px rgba(0,0,0,.34);overflow:hidden;}
.cl-spectrum-science::before{content:'';position:absolute;inset:-20% -15% auto;height:44%;background:radial-gradient(circle,rgba(210,13,47,.42),transparent 62%);filter:blur(10px);opacity:.82;}
.cl-spectrum-science__head{position:relative;z-index:1;display:flex;justify-content:space-between;align-items:flex-start;gap:18px;margin-bottom:18px;}
.cl-spectrum-science__eyebrow{display:block;font-size:10px;font-weight:950;letter-spacing:.14em;text-transform:uppercase;color:#ff6d7f;margin-bottom:7px;}
.cl-spectrum-science__title{margin:0;color:#fff;font-size:clamp(20px,2.4vw,28px);line-height:1.02;font-weight:950;max-width:310px;}
.cl-spectrum-science__badge{flex:0 0 auto;width:74px;height:74px;border-radius:50%;background:radial-gradient(circle at 50% 42%,rgba(255,255,255,.16),rgba(255,255,255,.04));border:1px solid rgba(255,255,255,.16);display:flex;flex-direction:column;align-items:center;justify-content:center;color:#fff;box-shadow:0 0 34px rgba(210,13,47,.32);}
.cl-spectrum-science__badge strong{font-size:28px;line-height:1;font-weight:950;}
.cl-spectrum-science__badge span{font-size:9px;font-weight:900;letter-spacing:.08em;text-transform:uppercase;color:rgba(255,255,255,.62);}
.cl-spectrum-science__legend{position:relative;z-index:1;display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:6px;margin-bottom:14px;}
.cl-spectrum-science__chip{border:1px solid rgba(255,255,255,.1);background:rgba(255,255,255,.055);border-radius:14px;padding:8px 4px;text-align:center;}
.cl-spectrum-science__dot{display:block;width:14px;height:14px;margin:0 auto 6px;border-radius:50%;background:var(--wave);box-shadow:0 0 22px color-mix(in srgb,var(--wave) 76%,transparent);}
.cl-spectrum-science__nm{display:block;color:#fff;font-size:11px;font-weight:950;line-height:1;}
.cl-spectrum-science__tag{display:block;color:rgba(255,255,255,.6);font-size:8px;font-weight:850;line-height:1.2;margin-top:4px;}
.cl-spectrum-science__diagram{position:relative;z-index:1;height:210px;border:1px solid rgba(255,255,255,.12);border-radius:22px;overflow:hidden;background:linear-gradient(180deg,#15181d 0%,#23191a 34%,#3a1715 62%,#4b1214 100%);margin-bottom:16px;}
.cl-spectrum-science__layer{position:absolute;left:0;right:0;border-top:1px solid rgba(255,255,255,.14);color:rgba(255,255,255,.62);font-size:9px;font-weight:900;letter-spacing:.08em;text-transform:uppercase;padding:7px 10px;}
.cl-spectrum-science__layer--skin{top:18%;}
.cl-spectrum-science__layer--tissue{top:48%;}
.cl-spectrum-science__layer--muscle{top:76%;}
.cl-spectrum-science__rays{position:absolute;inset:0 16px;display:grid;grid-template-columns:repeat(7,1fr);align-items:start;gap:8px;}
.cl-spectrum-science__ray{height:var(--depth);border-radius:0 0 999px 999px;background:linear-gradient(180deg,var(--wave),transparent);box-shadow:0 0 24px color-mix(in srgb,var(--wave) 70%,transparent);opacity:.84;}
.cl-spectrum-science__body{position:relative;z-index:1;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:8px;margin:0;padding:0;list-style:none;}
.cl-spectrum-science__body li{border:1px solid rgba(255,255,255,.1);background:rgba(255,255,255,.06);border-radius:999px;padding:8px 10px;color:rgba(255,255,255,.78);font-size:11px;font-weight:850;text-align:center;}
/* ===== SPEC TABLE ===== */
.cl-spec-section{padding:80px 40px;border-top:1px solid #f0f0f0;}
.cl-spec-inner{max-width:1000px;margin:0 auto;}
.cl-spec-header{text-align:center;margin-bottom:44px;}
.cl-spec-eyebrow{font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#d20d2f;margin:0 0 14px;}
.cl-spec-title{font-size:34px;font-weight:900;color:#0d0d0d;margin:0;letter-spacing:-.02em;}
.cl-spec-table-wrap{border:1.5px solid #eee;border-radius:18px;overflow:hidden;}
.cl-spec-table{width:100%;border-collapse:collapse;}
.cl-spec-table tr{border-bottom:1px solid #f0f0f0;}
.cl-spec-table tr:last-child{border-bottom:none;}
.cl-spec-table tr:nth-child(even){background:#fafafa;}
.cl-spec-table th{width:200px;padding:17px 24px;font-size:13px;font-weight:800;color:#0d0d0d;text-align:left;vertical-align:top;white-space:nowrap;}
.cl-spec-table td{padding:17px 24px;font-size:13px;color:#555;line-height:1.65;}
/* ===== FAQ ===== */
.cl-faq-section{max-width:1400px;margin:0 auto;padding:56px 40px;border-top:1px solid #f0f0f0;}
.cl-faq-header{text-align:center;margin-bottom:40px;}
.cl-faq-header__eyebrow{font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#d20d2f;margin:0 0 10px;}
.cl-faq-header__title{font-size:32px;font-weight:900;color:#0d0d0d;margin:0 0 10px;letter-spacing:-.02em;}
.cl-faq-header__sub{font-size:15px;color:#888;margin:0;}
.cl-faq-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:12px;}
.cl-faq-item{border:1.5px solid #eee;border-radius:14px;overflow:hidden;transition:border-color .2s;}
.cl-faq-item[open]{border-color:#d20d2f;}
.cl-faq-item summary{list-style:none;cursor:pointer;padding:20px 22px;font-size:15px;font-weight:700;color:#0d0d0d;display:flex;justify-content:space-between;align-items:center;gap:16px;user-select:none;-webkit-user-select:none;}
.cl-faq-item summary::-webkit-details-marker{display:none;}
.cl-faq-item summary:focus{outline:none;}
.cl-faq-toggle{width:28px;height:28px;border-radius:50%;background:#f5f5f5;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:18px;font-weight:400;color:#d20d2f;transition:background .2s,transform .2s;line-height:1;}
.cl-faq-item[open] .cl-faq-toggle{background:#fff0f0;transform:rotate(45deg);}
.cl-faq-body{padding:0 22px 20px;font-size:14px;line-height:1.75;color:#555;border-top:1px solid #f5f5f5;}
.cl-faq-body p{margin:12px 0 0;}
.cl-faq-body ul{margin:10px 0 0;padding-left:18px;}
.cl-faq-body li{margin-bottom:6px;}
.cl-faq-body strong{color:#0d0d0d;}
.cl-faq-cta{text-align:center;margin-top:36px;padding:28px;background:#fafafa;border-radius:16px;}
.cl-faq-cta p{font-size:15px;color:#555;margin:0 0 16px;}
.cl-faq-cta a{display:inline-flex;align-items:center;gap:8px;background:#0d0d0d;color:#fff;font-size:14px;font-weight:700;border-radius:10px;padding:12px 24px;text-decoration:none;transition:background .2s;}
@media (hover: hover) and (pointer: fine) { .cl-faq-cta a:hover{background:#333;} }
/* ===== COMPARISON ===== */
.cl-compare-section{max-width:1400px;margin:0 auto;padding:56px 40px 72px;border-top:1px solid #f0f0f0;}
.cl-compare-header{text-align:center;margin-bottom:32px;}
.cl-compare-header__eyebrow{font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#d20d2f;margin:0 0 10px;}
.cl-compare-header__title{font-size:32px;font-weight:900;color:#0d0d0d;margin:0 0 10px;letter-spacing:-.02em;}
.cl-compare-header__sub{font-size:15px;color:#888;margin:0 auto;max-width:640px;line-height:1.6;}
.cl-compare-table-wrap{overflow-x:auto;border-radius:16px;border:1px solid #eee;-webkit-overflow-scrolling:touch;}
.cl-compare-table{width:100%;min-width:820px;border-collapse:collapse;background:#fff;}
.cl-compare-table th,.cl-compare-table td{padding:16px 18px;border-bottom:1px solid #f0f0f0;text-align:left;font-size:13.5px;color:#444;vertical-align:top;}
.cl-compare-table thead th{background:#0d0d0d;color:#fff;font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.08em;white-space:nowrap;}
.cl-compare-table thead th.cl-compare-current{background:#d20d2f;}
.cl-compare-table tbody th{font-weight:800;color:#0d0d0d;white-space:nowrap;background:#fafafa;font-size:12.5px;}
.cl-compare-table tbody tr:last-child th,.cl-compare-table tbody tr:last-child td{border-bottom:none;}
.cl-compare-table td.cl-compare-current{background:#fff5f5;box-shadow:inset 1px 0 0 rgba(210,13,47,.18),inset -1px 0 0 rgba(210,13,47,.18);}
.cl-compare-badge{display:block;font-size:9.5px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:#ff9d9d;margin-bottom:2px;}
.cl-compare-link{display:inline-flex;align-items:center;gap:6px;padding:8px 14px;border-radius:999px;background:#0d0d0d;color:#fff;font-size:12px;font-weight:700;text-decoration:none;transition:background .2s;white-space:nowrap;}
@media (hover: hover) and (pointer: fine) { .cl-compare-link:hover{background:#d20d2f;} }
.cl-compare-current-tag{display:inline-flex;align-items:center;padding:8px 14px;border-radius:999px;background:#fff;border:1.5px solid #d20d2f;color:#d20d2f;font-size:12px;font-weight:800;white-space:nowrap;}
/* ===== RESPONSIVE ===== */
