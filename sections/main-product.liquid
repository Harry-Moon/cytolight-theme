  .cl-col-left{position:static;padding-right:0;}
  .cl-col-right{padding-left:0;margin-top:28px;}
  .cl-title{font-size:26px;}
  .cl-price{font-size:26px;}
  .cl-proof-grid{grid-template-columns:minmax(0,1fr);gap:8px;}
  .cl-buy-panel{padding:14px;border-radius:14px;}
  .cl-benefits{grid-template-columns:repeat(2,minmax(0,1fr));}
  .cl-notice-grid{grid-template-columns:minmax(0,1fr);}
  .cl-bundles{flex-direction:column;gap:12px;}
  .cl-bundle{display:flex;align-items:center;justify-content:space-between;gap:12px;text-align:left;padding:14px 16px;}
  .cl-bundle__row{justify-content:flex-start;flex:1;min-width:0;}
  .cl-bundle__unit{line-height:1.3;}
  .cl-bundle__save{margin-top:0;min-height:0;flex:0 0 auto;text-align:right;}
  /* Le badge quitte le centre : sur une carte pleine largeur il flottait au
     milieu du bord haut, a cheval sur la carte precedente. */
