/* Petits telephones (320-420px). Ce palier ne redessine rien : il resserre
   les blocs ou la mise en page de 900px ne rentre plus au pixel pres. */
@media (max-width:420px){
  /* Sept longueurs d'onde a 30px plus six gouttieres de 8 font 258px, pour
     248px disponibles a 320 : la derniere pastille etait coupee. */
  .cl-wave-dots{gap:5px;}
  .cl-wave-dot__circle{width:22px;height:22px;}
  .cl-wave-bar{padding:16px;}
  .cl-launch-hero__inner{padding:64px 16px 24px;}
