  .cl-mask-uses__title{font-size:26px;}
  .cl-mask-uses__grid{grid-template-columns:minmax(0,1fr);gap:12px;}
  .cl-mask-use{min-height:230px;border-radius:16px;}
  .cl-mask-use__title{font-size:18px;}
  .cl-product-wrap{grid-template-columns:minmax(0,1fr);padding:20px 16px;}
  .cl-notice-section{border-radius:22px;margin:0 16px 40px;padding:32px 18px 36px;}
  .cl-notice-grid{grid-template-columns:minmax(0,1fr);margin-bottom:40px;}
