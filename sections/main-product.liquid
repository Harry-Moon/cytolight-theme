  .cl-payment-row{grid-template-columns:minmax(0,1fr);}
  .cl-sticky-atc{top:calc(var(--header-h, 0px) + 8px);width:calc(100% - 20px);border-radius:14px;padding:10px;}
  .cl-sticky-atc__title{max-width:180px;font-size:12px;}
  .cl-sticky-atc__meta{font-size:11px;}
  .cl-sticky-atc__button{padding:12px 13px;font-size:12px;}
  .cl-thumbitem{flex:0 0 74px;height:74px;}
  .cl-stats-strip{padding:36px 16px;}
  .cl-stats-inner{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;}
  .cl-stat__num{font-size:36px;}
  .cl-editorial{padding:48px 16px;}
  .cl-editorial__inner{grid-template-columns:minmax(0,1fr);gap:36px;}
  .cl-editorial--img-right .cl-editorial__inner{direction:ltr;}
  .cl-editorial__title{font-size:26px;}
  .cl-why-section{padding:48px 16px;}
  .cl-why-header{grid-template-columns:minmax(0,1fr);gap:18px;margin-bottom:22px;}
  .cl-why-header--desk .cl-why-header__visual,.cl-why-header--desk .cl-why-eyebrow,.cl-why-header--desk .cl-why-title,.cl-why-header--desk .cl-why-sub,.cl-why-header--cap .cl-why-header__visual,.cl-why-header--cap .cl-why-eyebrow,.cl-why-header--cap .cl-why-title,.cl-why-header--cap .cl-why-sub{grid-column:1;grid-row:auto;}
  .cl-why-header__visual{aspect-ratio:16/11;border-radius:20px;margin-bottom:2px;}
  .cl-why-sub{font-size:15px;}
  .cl-why-grid{display:flex;flex-direction:column;gap:16px;padding-bottom:0;overflow:visible;}
  .cl-why-card,.cl-why-card:nth-child(even){display:grid;grid-template-columns:minmax(0,1fr);min-height:0;padding:0;border-radius:24px;}
  .cl-why-card:nth-child(even) .cl-why-card__text,.cl-why-card:nth-child(even) .cl-why-card__media{grid-column:1;grid-row:auto;}
