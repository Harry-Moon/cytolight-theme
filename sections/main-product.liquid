          <img src='{{ "cytolight-cap-editorial-consistency.jpg" | file_url }}' alt='{% if is_fr %}CYTOLIGHT cap avec LED int&eacute;gr&eacute;es pour une routine cheveux r&eacute;guli&egrave;re{% else %}CYTOLIGHT cap with integrated LEDs for a consistent hair routine{% endif %}' loading='lazy' class='cl-editorial__img' width='1456' height='1042'>
        {%- elsif is_foot and foot_image_1 -%}
          <img src='{{ foot_image_1 | image_url: width: 1400 }}' alt='{{ foot_image_1.alt | escape }}' loading='lazy' class='cl-editorial__img' width='1400' height='788'>
