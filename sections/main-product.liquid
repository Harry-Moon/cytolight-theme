          <li>{% if is_cap %}{% if is_fr %}S&eacute;lection des longueurs d'onde{% else %}Wavelength selection{% endif %}{% elsif is_mask %}{% if is_fr %}Sans fil, batterie 1800 mAh{% else %}Cordless, 1800mAh battery{% endif %}{% elsif is_foot %}{% if is_fr %}Simple &agrave; porter pendant le repos{% else %}Simple to wear while resting{% endif %}{% elsif is_knee %}{% if is_fr %}Batterie magnétique 6000 mAh rechargeable{% else %}Rechargeable 6000mAh magnetic battery{% endif %}{% elsif is_sauna_dome %}{% if is_fr %}4 bobines PEMF, 1&ndash;30Hz{% else %}4 PEMF coils, 1&ndash;30Hz{% endif %}{% else %}{% if is_fr %}Contr&ocirc;le depuis votre t&eacute;l&eacute;phone{% else %}App-controlled from your phone{% endif %}{% endif %}</li>
        </ul>
      </div>
