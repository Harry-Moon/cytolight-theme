  .cl-why-card__title{font-size:34px;line-height:1;margin-bottom:16px;}
  .cl-why-card__body{font-size:15px;line-height:1.65;margin-bottom:18px;}
  .cl-why-lesson{margin-top:14px;padding-top:14px;}
  .cl-why-proof{margin-top:16px;}
  .cl-why-proof span{padding:7px 9px;font-size:10px;}
  .cl-why-card__media{min-height:220px;margin:10px;border-radius:18px;}
  .cl-why-placeholder{width:min(64%,220px);border-radius:22px;}
