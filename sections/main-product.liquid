  {% render 'cytolight-notice-section', is_cap: is_cap, is_mask: is_mask, is_foot: is_foot, is_knee: is_knee, is_sauna_dome: is_sauna_dome, is_pano_ultra: is_pano_ultra, is_fr: is_fr %}


