        <div class='cl-benefit'><div class='cl-benefit__icon'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><path d='M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z'/></svg></div><span class='cl-benefit__label'>{% if is_cap %}{% if is_fr %}Mains libres{% else %}Hands-Free{% endif %}{% elsif is_mask %}{% if is_fr %}Sans fil{% else %}Cordless{% endif %}{% elsif is_foot %}{% if is_fr %}Mains libres{% else %}Hands-free{% endif %}{% elsif is_knee %}{% if is_fr %}Mains libres{% else %}Hands-free{% endif %}{% elsif is_sauna_dome %}{% if is_fr %}PEMF{% else %}PEMF{% endif %}{% else %}{% if is_fr %}Peau{% else %}Skin Health{% endif %}{% endif %}</span><span class='cl-benefit__sub'>{% if is_cap %}{% if is_fr %}Simple &agrave; porter{% else %}Easy to wear{% endif %}{% elsif is_mask %}{% if is_fr %}1800 mAh{% else %}1800mAh{% endif %}{% elsif is_foot %}{% if is_fr %}Repos &agrave; domicile{% else %}At-home rest{% endif %}{% elsif is_knee %}{% if is_fr %}6000 mAh{% else %}6000mAh{% endif %}{% elsif is_sauna_dome %}{% if is_fr %}4 bobines{% else %}4 coils{% endif %}{% else %}{% if is_fr %}Collag&egrave;ne et &eacute;clat{% else %}Collagen &amp; glow{% endif %}{% endif %}</span></div>
