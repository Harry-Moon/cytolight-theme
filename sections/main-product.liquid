  <!-- ===== EDITORIAL 2: 7 wavelengths (dark, shader bg) ===== -->
  <div class='cl-editorial cl-editorial--dark'>
    <canvas id='cl-shader-bg' class='cl-shader-canvas'></canvas>
    <div class='cl-editorial__inner'>
      <div class='cl-editorial__copy'>
