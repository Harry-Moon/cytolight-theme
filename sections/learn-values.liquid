{%- comment -%}
  Donnees structurees : Article + BreadcrumbList + FAQPage, ce dernier
  construit sur faq_items -- la meme source que les <details> visibles.

  Aucun type medical, et aucune citation en propre : cette page ne cite aucune
  publication, les references vivent sur learn-science.
{%- endcomment -%}
{%- liquid
  if is_fr
    assign sd_headline = 'Nos valeurs : comment nous selectionnons un appareil, et ce que nous refusons d ecrire'
    assign sd_desc = 'DOI sur chaque etude citee, irradiance publiee avec sa distance, aucune note ecrite a la main, aucune promesse therapeutique. Les regles que nous nous imposons, verifiables page par page.'
    assign sd_home = 'Accueil'
    assign sd_learn = 'Apprendre'
    assign sd_page = 'Nos valeurs'
  else
    assign sd_headline = 'Our values: how we select a device, and what we refuse to write'
    assign sd_desc = 'A DOI on every study cited, irradiance published with its distance, no hand-written ratings, no therapeutic promise. The rules we hold ourselves to, checkable page by page.'
    assign sd_home = 'Home'
    assign sd_learn = 'Learn'
    assign sd_page = 'Our values'
  endif

  assign sd_home_url = request.origin | append: routes.root_url
  assign sd_learn_url = request.origin | append: learn_url
-%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": {{ canonical_url | append: '#article' | json }},
      "url": {{ canonical_url | json }},
      "mainEntityOfPage": {{ canonical_url | json }},
      "headline": {{ sd_headline | json }},
      "description": {{ sd_desc | json }},
      "inLanguage": {{ request.locale.iso_code | json }},
      "dateModified": {{ page_updated | json }},
      "author": {
        "@type": "Organization",
        "name": {{ shop.name | json }},
        "url": {{ request.origin | json }}
      },
      "publisher": {
        "@type": "Organization",
        "name": {{ shop.name | json }},
        "url": {{ request.origin | json }}
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": {{ sd_home | json }}, "item": {{ sd_home_url | json }} },
        { "@type": "ListItem", "position": 2, "name": {{ sd_learn | json }}, "item": {{ sd_learn_url | json }} },
        { "@type": "ListItem", "position": 3, "name": {{ sd_page | json }}, "item": {{ canonical_url | json }} }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {%- for faq_item in faq_items -%}
          {%- assign faq_parts = faq_item | split: '~' -%}
          {%- assign faq_q = faq_parts[0] | strip | strip_html | strip_newlines -%}
          {%- assign faq_a = faq_parts[1] | strip | strip_html | strip_newlines -%}
          {
            "@type": "Question",
            "name": {{ faq_q | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ faq_a | json }} }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  ]
}
</script>

