    <div class="ln-head ln-reveal">
      <div>
        <p class="ln-kicker">{% if is_fr %}Les questions qu'on nous pose{% else %}The questions we get asked{% endif %}</p>
        <h2 class="ln-title ln-title--wide">
          {%- if is_fr -%}Sept questions, y compris les d&eacute;sagr&eacute;ables.{%- else -%}Seven questions, including the awkward ones.{%- endif -%}
