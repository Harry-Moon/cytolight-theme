<section class="section {% if section.settings.background_soft %}section--soft{% endif %}">
  <div class="container">
    <div class="iwt {% if section.settings.reverse %}iwt--reverse{% endif %}">
      <div class="iwt__media">
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 1200 }}"
               alt="{{ section.settings.image.alt | escape }}"
               width="1200" height="{{ 1200 | divided_by: section.settings.image.aspect_ratio | round }}"
               loading="lazy">
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'iwt__media-placeholder' }}
        {%- endif -%}
      </div>
      <div class="iwt__body">
        {% if section.settings.eyebrow != blank %}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{% endif %}
        <h2>{{ section.settings.heading | default: 'A new ritual for radiance' }}</h2>
        <p>{{ section.settings.text | default: 'Lorem ipsum copy explaining the science and benefits — keep it short and crisp, with one big claim and one supporting sentence.' }}</p>
        {% if section.settings.cta_label != blank %}
          <a class="btn btn--secondary" href="{{ section.settings.cta_url | default: '#' }}">{{ section.settings.cta_label }} <span aria-hidden="true">→</span></a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Body text" },
    { "type": "text", "id": "cta_label", "label": "CTA label" },
    { "type": "url", "id": "cta_url", "label": "CTA link" },
    { "type": "checkbox", "id": "reverse", "label": "Image on right", "default": false },
    { "type": "checkbox", "id": "background_soft", "label": "Soft background", "default": false }
  ],
  "presets": [{ "name": "Image with text" }]
}
{% endschema %}
