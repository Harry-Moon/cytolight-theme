<section class="hero">
  <div class="hero__media">
    {%- if section.settings.video != blank -%}
      <video src="{{ section.settings.video.sources[1].url | default: section.settings.video.sources[0].url }}"
             autoplay loop muted playsinline poster="{% if section.settings.poster != blank %}{{ section.settings.poster | image_url: width: 1800 }}{% endif %}"></video>
    {%- elsif section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 1800 }}" alt="{{ section.settings.image.alt | escape }}" loading="eager">
    {%- endif -%}
  </div>
  <div class="hero__overlay"></div>
  <div class="hero__content">
    {% if section.settings.eyebrow != blank %}<span class="eyebrow" style="color: rgba(255,255,255,.75)">{{ section.settings.eyebrow }}</span>{% endif %}
    <h1 class="hero__title">{% if request.locale.iso_code contains 'fr' %}R&eacute;cup&eacute;rez mieux. Dormez plus profond&eacute;ment. Rayonnez davantage.{% else %}{{ section.settings.heading | default: 'Recover Faster. Sleep Deeper. Look Better.' }}{% endif %}</h1>
    <p class="hero__subtitle">{% if request.locale.iso_code contains 'fr' %}Technologies bien-&ecirc;tre inspir&eacute;es par la science pour accompagner le sommeil, la r&eacute;cup&eacute;ration et l'&eacute;clat de la peau.{% else %}{{ section.settings.subheading | default: 'Science-backed wellness technologies to enhance sleep, recovery, and beauty.' }}{% endif %}</p>
    <div class="hero__ctas">
      {% if section.settings.cta_label != blank %}
        <a class="btn btn--primary" href="{{ section.settings.cta_url | default: '#' }}">{{ section.settings.cta_label }} <span aria-hidden="true">→</span></a>
      {% endif %}
      {% if section.settings.cta_secondary_label != blank %}
        <a class="btn btn--ghost" href="{{ section.settings.cta_secondary_url | default: '#' }}" style="color:#fff;border-color:rgba(255,255,255,.4);">{{ section.settings.cta_secondary_label }}</a>
      {% endif %}
    </div>
    {% if section.settings.show_proof %}
      <div class="hero__proof">
        <span><span class="hero__stars">★★★★★</span> <strong>{{ section.settings.rating_text | default: '4.95/5' }}</strong> {% if request.locale.iso_code contains 'fr' %}par plus de 5 700 avis{% else %}{{ section.settings.review_text | default: 'by 5,700+ Reviews' }}{% endif %}</span>
        <span><strong>{% if request.locale.iso_code contains 'fr' %}Adopt&eacute; par {{ section.settings.customer_count | default: '400,000+' }}{% else %}Trusted by {{ section.settings.customer_count | default: '400,000+' }}{% endif %}</strong> {% if request.locale.iso_code contains 'fr' %}clients{% else %}customers{% endif %}</span>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Hero video",
  "settings": [
    { "type": "video", "id": "video", "label": "Background video" },
    { "type": "image_picker", "id": "image", "label": "Fallback image" },
    { "type": "image_picker", "id": "poster", "label": "Video poster" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Recover Faster. Sleep Deeper. Look Better." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Science-backed wellness technologies to enhance sleep, recovery, and beauty." },
    { "type": "text", "id": "cta_label", "label": "Primary CTA label", "default": "Shop best sellers" },
    { "type": "url", "id": "cta_url", "label": "Primary CTA link" },
    { "type": "text", "id": "cta_secondary_label", "label": "Secondary CTA label", "default": "Take our 30-second quiz" },
    { "type": "url", "id": "cta_secondary_url", "label": "Secondary CTA link" },
    { "type": "checkbox", "id": "show_proof", "label": "Show social proof", "default": true },
    { "type": "text", "id": "rating_text", "label": "Rating text", "default": "4.95/5" },
    { "type": "text", "id": "review_text", "label": "Review text", "default": "by 5,700+ Reviews" },
    { "type": "text", "id": "customer_count", "label": "Customer count", "default": "400,000+" }
  ],
  "presets": [{ "name": "Hero video" }]
}
{% endschema %}
