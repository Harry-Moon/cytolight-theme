{%- comment -%}
  Banniere de collection.

  La seule collection reelle du catalogue avec plusieurs produits est `panels`.
  Les cinq objectifs (recovery, performance, skin-amp-glow, longevity,
  work-amp-focus) ne sont pas des collections : ce sont des pages, servies par
  `sections/goal-page.liquid` (voir CLAUDE.md, « Sous-pages Par objectif »).

  Cette banniere garde donc un rendu unique, utilise par `/collections/all`,
  `/collections/panels` et toute collection future.
{%- endcomment -%}

{%- liquid
  assign is_fr = false
  if request.locale.iso_code contains 'fr'
    assign is_fr = true
  endif

  assign locale_root = routes.root_url
  if locale_root == '/'
    assign locale_root = ''
  endif
-%}

{%- comment -%}
  La fiche DESK est visee par son objet produit plutot que par un chemin ecrit
  en dur : product.url porte le prefixe de langue, un chemin nu ramene le
  visiteur anglophone sur la version francaise.
{%- endcomment -%}
{%- assign desk_product = all_products['cytolight-desk'] -%}
{%- assign desk_url = locale_root | append: '/products/cytolight-desk' -%}
{%- if desk_product != blank -%}
  {%- assign desk_url = desk_product.url -%}
{%- endif -%}

{%- if collection.handle == 'all' -%}
  {{ 'collection-banner-video.css' | asset_url | stylesheet_tag }}
{%- endif -%}

<section class="collection-banner collection-banner--cyto">
  {%- if collection.handle == 'all' -%}
    <div class="collection-banner__video" aria-hidden="true">
      <video src="https://cdn.shopify.com/videos/c/o/v/7c5e3e2ed7e04dd38d5a5e21485e9363.mp4" autoplay loop muted playsinline></video>
    </div>
  {%- endif -%}
  <div class="container collection-banner__inner">
    <div class="collection-banner__copy">
      <span class="eyebrow">{% if is_fr %}Catalogue Antared{% else %}Antared catalogue{% endif %}</span>
      <h1>{% if is_fr %}Choisissez la lumi&egrave;re faite pour votre espace.{% else %}Choose the light built for your space.{% endif %}</h1>
      <p>
        {% if collection.description != blank %}
          {{ collection.description }}
        {% elsif is_fr %}
          D&eacute;couvrez les formats Antared pour le bureau, la routine cheveux, la r&eacute;cup&eacute;ration et les espaces wellness. Certains produits arrivent bient&ocirc;t.
        {% else %}
          Explore Antared formats for desk rituals, hair routines, recovery, and wellness spaces. Some products are arriving soon.
        {% endif %}
      </p>
      <div class="collection-banner__actions">
        <a class="btn btn--primary" href="#collection-products">{% if is_fr %}Voir les produits{% else %}View products{% endif %}</a>
        <a class="btn btn--ghost collection-banner__ghost" href="{{ desk_url }}">{% if is_fr %}Commencer par DESK{% else %}Start with DESK{% endif %}</a>
      </div>
    </div>
    <div class="collection-banner__tease" aria-label="{% if is_fr %}Points forts{% else %}Highlights{% endif %}">
      <div><strong>{% if is_fr %}Rituel{% else %}Ritual{% endif %}</strong><span>{% if is_fr %}Des formats simples &agrave; int&eacute;grer dans votre journ&eacute;e.{% else %}Formats designed to fit naturally into your day.{% endif %}</span></div>
      <div><strong>{% if is_fr %}Cibl&eacute;{% else %}Targeted{% endif %}</strong><span>{% if is_fr %}Bureau, cheveux, r&eacute;cup&eacute;ration ou corps entier.{% else %}Desk, hair, recovery, or full-body wellness.{% endif %}</span></div>
      <div><strong>{% if is_fr %}Premium{% else %}Premium{% endif %}</strong><span>{% if is_fr %}Une pr&eacute;sence design pour la maison ou le studio.{% else %}A design presence for home or studio spaces.{% endif %}</span></div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection banner",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Banniere catalogue, utilisee par toutes les collections (all, panels, et toute collection future). Les cinq objectifs (recovery, performance, skin-amp-glow, longevity, work-amp-focus) sont des pages, pas des collections : leur hero vient de « Par objectif — page »."
    }
  ]
}
{% endschema %}
