          <p class="ln-bodymap__what">{% if is_fr %}Acuit&eacute; visuelle en essai randomis&eacute; contre placebo{% else %}Visual acuity in a randomised sham-controlled trial{% endif %}</p></div></li>
        <li class="ln-bodymap__item"><span class="ln-bodymap__n">03</span><div>
          <p class="ln-bodymap__zone">{% if is_fr %}Peau du visage{% else %}Facial skin{% endif %}</p>
          <p class="ln-bodymap__what">{% if is_fr %}Densit&eacute; de collag&egrave;ne en &eacute;chographie, rugosit&eacute; en profilom&eacute;trie{% else %}Collagen density by ultrasound, roughness by profilometry{% endif %}</p></div></li>
        <li class="ln-bodymap__item"><span class="ln-bodymap__n">04</span><div>
