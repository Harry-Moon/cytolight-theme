      <ol class="ln-bodymap__list ln-bodymap__list--right" start="6">
        <li class="ln-bodymap__item"><span class="ln-bodymap__n">06</span><div>
          <p class="ln-bodymap__zone">{% if is_fr %}Muscle, avant l'effort{% else %}Muscle, before exercise{% endif %}</p>
          <p class="ln-bodymap__what">{% if is_fr %}R&eacute;p&eacute;titions et temps avant &eacute;puisement, 13 essais{% else %}Repetitions and time to exhaustion, 13 trials{% endif %}</p></div></li>
        <li class="ln-bodymap__item"><span class="ln-bodymap__n">07</span><div>
          <p class="ln-bodymap__zone">{% if is_fr %}Muscle, apr&egrave;s l'effort{% else %}Muscle, after exercise{% endif %}</p>
          <p class="ln-bodymap__what">{% if is_fr %}Cr&eacute;atine kinase, effet net en localis&eacute; seulement{% else %}Creatine kinase, clear effect for localised exercise only{% endif %}</p></div></li>
        <li class="ln-bodymap__item"><span class="ln-bodymap__n">08</span><div>
          <p class="ln-bodymap__zone">{% if is_fr %}Genou{% else %}Knee{% endif %}</p>
