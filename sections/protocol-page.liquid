              <span class="ln-hub__num">{{ index_numeros[forloop.index0] }}</span>
              <h3 class="ln-hub__title">{% if is_fr %}{{ index_titres_fr[forloop.index0] }}{% else %}{{ index_titres_en[forloop.index0] }}{% endif %}</h3>
              <p class="ln-hub__text">{% if is_fr %}{{ index_textes_fr[forloop.index0] }}{% else %}{{ index_textes_en[forloop.index0] }}{% endif %}</p>
              <a class="ln-link" href="{{ lien }}">{% if is_fr %}Lire le protocole{% else %}Read the protocol{% endif %}</a>
            </article>
          {%- endfor -%}
        </div>
      </div>
    </section>

  {%- else -%}

    <section class="ln-section ln-section--soft">
      <div class="ln-shell">
        <div class="ln-head">
          <div>
            <p class="ln-kicker">{% if is_fr %}La s&eacute;ance{% else %}The session{% endif %}</p>
            <h2 class="ln-subtitle">{% if is_fr %}Quatre chiffres, et rien &agrave; deviner{% else %}Four numbers, nothing left to guess{% endif %}</h2>
