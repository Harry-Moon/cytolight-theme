{%- comment -%}
  Gabarit Protocoles > Recuperation quotidienne.

  A assigner dans l'admin Shopify a la page de handle `daily-recovery`
  (Content > Pages > Daily recovery > Theme template : page.daily-recovery).

  Le contenu vit dans `sections/protocol-page.liquid`, qui derive le protocole
  depuis le handle de la page. Ce gabarit ne porte que l'enveloppe.
{%- endcomment -%}

{{ 'learn.css' | asset_url | stylesheet_tag }}
<script src="{{ 'learn.js' | asset_url }}" defer></script>

<div class="ln-page" data-learn>
  {% section 'protocol-page' %}

  {%- if page.content != blank -%}
    <section class="ln-section ln-section--tight">
      <div class="ln-shell ln-shell--narrow">
        <div class="ln-prose">{{ page.content }}</div>
      </div>
    </section>
  {%- endif -%}
</div>
