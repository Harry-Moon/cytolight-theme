{%- assign is_fr = false -%}
{%- if request.locale.iso_code contains 'fr' -%}
  {%- assign is_fr = true -%}
{%- endif -%}

{{ 'error-404.css' | asset_url | stylesheet_tag }}

<section class="error-404">
  <div class="error-404__video" aria-hidden="true">
    <video src="https://cdn.shopify.com/videos/c/o/v/7c5e3e2ed7e04dd38d5a5e21485e9363.mp4" autoplay loop muted playsinline></video>
  </div>
  <div class="error-404__inner">
    <p class="error-404__eyebrow">404</p>
    <h1 class="error-404__title">{% if is_fr %}Cette lumi&egrave;re s'est &eacute;gar&eacute;e.{% else %}This light got lost.{% endif %}</h1>
    <p class="error-404__body">
      {% if is_fr %}
        La page que vous cherchez n'existe pas ou a &eacute;t&eacute; d&eacute;plac&eacute;e. Revenons &agrave; l'essentiel.
      {% else %}
        The page you're looking for doesn't exist or has moved. Let's get you back on track.
      {% endif %}
    </p>
    <div class="error-404__actions">
      <a href="{{ routes.root_url }}" class="btn btn--primary">{% if is_fr %}Retour &agrave; l'accueil{% else %}Back to home{% endif %} &rarr;</a>
      <a href="{{ routes.all_products_collection_url }}" class="btn btn--ghost error-404__ghost">{% if is_fr %}Voir tous les produits{% else %}Shop all products{% endif %}</a>
    </div>
  </div>
</section>
