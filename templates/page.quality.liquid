{%- comment -%}
  Gabarit Pourquoi Antared > Qualite.

  A assigner dans l'admin Shopify a la page de handle `quality`
  (Content > Pages > Quality > Theme template : page.quality).

  Le contenu vit dans `sections/why-page.liquid`, qui le derive depuis le
  handle de la page. Ce gabarit ne porte que l'enveloppe.
{%- endcomment -%}

{{ 'learn.css' | asset_url | stylesheet_tag }}
<script src="{{ 'learn.js' | asset_url }}" defer></script>

<div class="ln-page" data-learn>
  {% section 'why-page' %}

  {%- if page.content != blank -%}
    <section class="ln-section ln-section--tight">
      <div class="ln-shell ln-shell--narrow">
        <div class="ln-prose">{{ page.content }}</div>
      </div>
    </section>
  {%- endif -%}
</div>
